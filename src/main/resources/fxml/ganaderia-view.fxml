<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.GanaderiaController"
      spacing="14" styleClass="page">

    <!-- Indicadores principales -->
    <HBox fx:id="indicadores" spacing="16"/>

    <!-- Período (para movimientos, producción e indicadores) -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Período" styleClass="form-label"/>
        <DatePicker fx:id="dpDesde" prefWidth="135"/>
        <Label text="al" styleClass="form-label"/>
        <DatePicker fx:id="dpHasta" prefWidth="135"/>
        <Button text="Últimos 12 meses" styleClass="button-secondary" minWidth="-Infinity" onAction="#ultimos12Meses"/>
        <Button text="Este año" styleClass="button-secondary" minWidth="-Infinity" onAction="#esteAnio"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevoMovimiento" text="Registrar movimiento" styleClass="button-primary" minWidth="-Infinity"
                onAction="#nuevoMovimiento">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <TabPane fx:id="pestanas" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <!-- 1. Hato -->
        <Tab text="Hato">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblHato" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btnInventarioInicial" text="Inventario inicial" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#inventarioInicial">
                        <graphic><FontIcon iconLiteral="fth-clipboard"/></graphic>
                    </Button>
                    <Button fx:id="btnPrecios" text="Precios por cabeza" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#editarPrecios">
                        <graphic><FontIcon iconLiteral="fth-tag"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaHato" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
                    <columns>
                        <TableColumn fx:id="colHatoCategoria" text="Especie y categoría" prefWidth="260" sortable="false"/>
                        <TableColumn fx:id="colHatoCabezas" text="Cabezas" prefWidth="90" sortable="false" styleClass="col-numero"/>
                        <TableColumn fx:id="colHatoPrecio" text="Precio por cabeza" prefWidth="140" sortable="false" styleClass="col-numero"/>
                        <TableColumn fx:id="colHatoValor" text="Valor" prefWidth="140" sortable="false" styleClass="col-numero"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Existencias de hoy, calculadas con los movimientos. El valor del hato (cabezas × precio de mercado) se suma al balance general en «Activos y deudas»."/>
            </VBox>
        </Tab>

        <!-- 2. Movimientos -->
        <Tab text="Movimientos">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cmbEspecie" prefWidth="150" minWidth="130"/>
                    <CheckBox fx:id="chkAnulados" text="Incluir anulados" minWidth="-Infinity" onAction="#cargar"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAnularMovimiento" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#anularMovimiento">
                        <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMovFecha" text="Fecha" prefWidth="90"/>
                        <TableColumn fx:id="colMovTipo" text="Movimiento" prefWidth="140"/>
                        <TableColumn fx:id="colMovCategoria" text="Especie y categoría" prefWidth="200"/>
                        <TableColumn fx:id="colMovCantidad" text="Cabezas" prefWidth="75" styleClass="col-numero"/>
                        <TableColumn fx:id="colMovMonto" text="Valor" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colMovDetalle" text="Detalle" prefWidth="220"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- 3. Producción -->
        <Tab text="Producción">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblProduccion" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btnAnularProduccion" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#anularProduccion">
                        <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
                    </Button>
                    <Button fx:id="btnNuevaProduccion" text="Registrar producción" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#nuevaProduccion">
                        <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaProduccion" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProdFecha" text="Fecha" prefWidth="90"/>
                        <TableColumn fx:id="colProdProducto" text="Producto" prefWidth="140"/>
                        <TableColumn fx:id="colProdCantidad" text="Cantidad" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colProdDias" text="Días" prefWidth="60" styleClass="col-numero"/>
                        <TableColumn fx:id="colProdAnimales" text="Animales" prefWidth="80" styleClass="col-numero"/>
                        <TableColumn fx:id="colProdPromedio" text="Promedio" prefWidth="120" styleClass="col-numero"/>
                        <TableColumn fx:id="colProdValor" text="Valor" prefWidth="100" styleClass="col-numero"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Puedes registrar la producción de cada día (días = 1) o el total de la semana o del mes. El promedio de leche es por vaca en ordeño y por día; el de fibra y lana, por animal esquilado."/>
            </VBox>
        </Tab>

        <!-- 4. Indicadores -->
        <Tab text="Indicadores">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll">
                <VBox fx:id="contenedorIndicadores" spacing="14" styleClass="tab-contenido"/>
            </ScrollPane>
        </Tab>
    </TabPane>
</VBox>
