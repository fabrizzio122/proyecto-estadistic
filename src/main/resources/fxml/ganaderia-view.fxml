<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.GanaderiaControllerFGEM"
      spacing="14" styleClass="page">

    <!-- Indicadores principales -->
    <HBox fx:id="indicadoresFGEM" spacing="16"/>

    <!-- Período (para movimientos, producción e indicadores) -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Período" styleClass="form-label"/>
        <DatePicker fx:id="dpDesdeFGEM" prefWidth="135"/>
        <Label text="al" styleClass="form-label"/>
        <DatePicker fx:id="dpHastaFGEM" prefWidth="135"/>
        <Button text="Últimos 12 meses" styleClass="button-secondary" minWidth="-Infinity" onAction="#ultimos12MesesFGEM"/>
        <Button text="Este año" styleClass="button-secondary" minWidth="-Infinity" onAction="#esteAnioFGEM"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevoMovimientoFGEM" text="Registrar movimiento" styleClass="button-primary" minWidth="-Infinity"
                onAction="#nuevoMovimientoFGEM">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <TabPane fx:id="pestanasFGEM" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <!-- 1. Hato -->
        <Tab text="Hato">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblHatoFGEM" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btnInventarioInicialFGEM" text="Inventario inicial" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#inventarioInicialFGEM">
                        <graphic><FontIcon iconLiteral="fth-clipboard"/></graphic>
                    </Button>
                    <Button fx:id="btnPreciosFGEM" text="Precios por cabeza" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#editarPreciosFGEM">
                        <graphic><FontIcon iconLiteral="fth-tag"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaHatoFGEM" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
                    <columns>
                        <TableColumn fx:id="colHatoCategoriaFGEM" text="Especie y categoría" prefWidth="260" sortable="false"/>
                        <TableColumn fx:id="colHatoCabezasFGEM" text="Cabezas" prefWidth="90" sortable="false" styleClass="col-numero"/>
                        <TableColumn fx:id="colHatoPrecioFGEM" text="Precio por cabeza" prefWidth="140" sortable="false" styleClass="col-numero"/>
                        <TableColumn fx:id="colHatoValorFGEM" text="Valor" prefWidth="140" sortable="false" styleClass="col-numero"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Existencias de hoy, calculadas con los movimientos. El valor del hato (cabezas × precio de mercado) se suma al balance general en «Activos y deudas»."/>
            </VBox>
        </Tab>

        <!-- 2. Movimientos -->
        <Tab text="Movimientos">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cmbEspecieFGEM" prefWidth="150" minWidth="130"/>
                    <CheckBox fx:id="chkAnuladosFGEM" text="Incluir anulados" minWidth="-Infinity" onAction="#cargarFGEM"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnEditarMovimientoFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarMovimientoFGEM">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnAnularMovimientoFGEM" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#anularMovimientoFGEM">
                        <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaMovimientosFGEM" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMovFechaFGEM" text="Fecha" prefWidth="90"/>
                        <TableColumn fx:id="colMovTipoFGEM" text="Movimiento" prefWidth="140"/>
                        <TableColumn fx:id="colMovCategoriaFGEM" text="Especie y categoría" prefWidth="200"/>
                        <TableColumn fx:id="colMovCantidadFGEM" text="Cabezas" prefWidth="75" styleClass="col-numero"/>
                        <TableColumn fx:id="colMovMontoFGEM" text="Valor" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colMovDetalleFGEM" text="Detalle" prefWidth="220"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- 3. Producción -->
        <Tab text="Producción">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblProduccionFGEM" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="btnEditarProduccionFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarProduccionFGEM">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnAnularProduccionFGEM" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#anularProduccionFGEM">
                        <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
                    </Button>
                    <Button fx:id="btnNuevaProduccionFGEM" text="Registrar producción" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#nuevaProduccionFGEM">
                        <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaProduccionFGEM" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProdFechaFGEM" text="Fecha" prefWidth="90"/>
                        <TableColumn fx:id="colProdProductoFGEM" text="Producto" prefWidth="140"/>
                        <TableColumn fx:id="colProdCantidadFGEM" text="Cantidad" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colProdDiasFGEM" text="Días" prefWidth="60" styleClass="col-numero"/>
                        <TableColumn fx:id="colProdAnimalesFGEM" text="Animales" prefWidth="80" styleClass="col-numero"/>
                        <TableColumn fx:id="colProdPromedioFGEM" text="Promedio" prefWidth="120" styleClass="col-numero"/>
                        <TableColumn fx:id="colProdValorFGEM" text="Valor" prefWidth="100" styleClass="col-numero"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Puedes registrar la producción de cada día (días = 1) o el total de la semana o del mes. El promedio de leche es por vaca en ordeño y por día; el de fibra y lana, por animal esquilado."/>
            </VBox>
        </Tab>

        <!-- 4. Indicadores -->
        <Tab text="Indicadores">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll">
                <VBox fx:id="contenedorIndicadoresFGEM" spacing="14" styleClass="tab-contenido"/>
            </ScrollPane>
        </Tab>

        <!-- 5. Evolución -->
        <Tab text="Evolución">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll">
                <VBox spacing="14" styleClass="tab-contenido">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Mostrar los últimos" styleClass="form-label"/>
                        <ComboBox fx:id="cmbMesesEvolucionFGEM" prefWidth="120"/>
                        <Label text="Independiente del período de arriba: siempre termina en el mes actual." styleClass="hint" wrapText="true"/>
                    </HBox>
                    <HBox spacing="16">
                        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS" prefWidth="400">
                            <Label text="Animales al cierre de cada mes" styleClass="card-title"/>
                            <StackPane fx:id="graficoExistenciasFGEM" minHeight="230" prefHeight="230"/>
                        </VBox>
                        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS" prefWidth="400">
                            <Label text="Nacimientos, muertes y salidas" styleClass="card-title"/>
                            <StackPane fx:id="graficoNacimientosFGEM" minHeight="230" prefHeight="230"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="16">
                        <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS" prefWidth="400">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Producción mensual y tendencia" styleClass="card-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <ComboBox fx:id="cmbProductoEvolucionFGEM" prefWidth="130"/>
                            </HBox>
                            <StackPane fx:id="graficoProduccionFGEM" minHeight="230" prefHeight="230"/>
                        </VBox>
                        <VBox styleClass="card" spacing="8" prefWidth="340" minWidth="300">
                            <Label text="Lectura" styleClass="card-title"/>
                            <VBox fx:id="lecturaEvolucionFGEM" spacing="6"/>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </Tab>
    </TabPane>
</VBox>
