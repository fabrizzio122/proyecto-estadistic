<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.DiagnosticoController"
      spacing="14" styleClass="page">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="lblPeriodo" styleClass="muted"/>
        <ProgressIndicator fx:id="progreso" prefWidth="22" prefHeight="22" visible="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Actualizar" styleClass="button-secondary" minWidth="-Infinity" onAction="#actualizar">
            <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="16">
        <!-- Calificación global -->
        <VBox styleClass="card" spacing="8" prefWidth="330" minWidth="270">
            <Label text="Salud del negocio" styleClass="card-title"/>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <HBox alignment="BASELINE_LEFT" spacing="2">
                    <Label fx:id="lblPuntaje" text="—" styleClass="puntaje-salud"/>
                    <Label text="/100" styleClass="muted"/>
                </HBox>
                <Label fx:id="lblNivel" styleClass="nivel-salud"/>
            </HBox>
            <VBox fx:id="resumen" spacing="4"/>
        </VBox>
        <!-- Puntaje por área -->
        <HBox fx:id="areas" spacing="16" HBox.hgrow="ALWAYS"/>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Semáforo de indicadores" styleClass="card-title"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="indicadores" spacing="2"/>
            </ScrollPane>
        </VBox>
        <VBox styleClass="card" spacing="8" prefWidth="380" minWidth="300">
            <Label text="Recomendaciones" styleClass="card-title"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="recomendaciones" spacing="12"/>
            </ScrollPane>
        </VBox>
    </HBox>
</VBox>
