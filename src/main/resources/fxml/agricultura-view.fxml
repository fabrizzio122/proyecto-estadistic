<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.AgriculturaControllerFGEM"
      spacing="14" styleClass="page">

    <HBox fx:id="indicadoresFGEM" spacing="16"/>

    <TabPane fx:id="pestanasFGEM" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <Tab text="Campañas">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cmbFiltroFGEM" prefWidth="150" minWidth="130"/>
                    <CheckBox fx:id="chkAnuladasFGEM" text="Incluir anuladas" minWidth="-Infinity" onAction="#cargarFGEM"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnCostoFGEM" text="Costo" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#registrarCostoFGEM">
                    </Button>
                    <Button fx:id="btnCosechaFGEM" text="Cosecha" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#registrarCosechaFGEM">
                    </Button>
                    <Button fx:id="btnCerrarFGEM" text="Cerrar campaña" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#cerrarCampaniaFGEM">
                    </Button>
                    <Button fx:id="btnRegistrosFGEM" text="Registros" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#verRegistrosFGEM">
                    </Button>
                    <MenuButton fx:id="menuMasFGEM" text="Más" styleClass="button-secondary" minWidth="-Infinity">
                        <items>
                            <MenuItem fx:id="itemEditarFGEM" text="Editar campaña…" onAction="#editarCampaniaFGEM"/>
                            <MenuItem fx:id="itemReabrirFGEM" text="Reabrir campaña" onAction="#reabrirCampaniaFGEM"/>
                            <MenuItem fx:id="itemAnularFGEM" text="Anular campaña…" onAction="#anularCampaniaFGEM"/>
                        </items>
                    </MenuButton>
                    <Button fx:id="btnNuevaCampaniaFGEM" text="Nueva campaña" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevaCampaniaFGEM">
                    </Button>
                </HBox>
                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tablaCampaniasFGEM" HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCamCultivoFGEM" text="Cultivo" prefWidth="175"/>
                            <TableColumn fx:id="colCamSiembraFGEM" text="Siembra" prefWidth="90"/>
                            <TableColumn fx:id="colCamAreaFGEM" text="Área" prefWidth="60" styleClass="col-numero"/>
                            <TableColumn fx:id="colCamEstadoFGEM" text="Estado" prefWidth="90"/>
                            <TableColumn fx:id="colCamCostoFGEM" text="Costo" prefWidth="95" styleClass="col-numero"/>
                            <TableColumn fx:id="colCamRendimientoFGEM" text="kg/ha" prefWidth="75" styleClass="col-numero"/>
                            <TableColumn fx:id="colCamMargenFGEM" text="Margen" prefWidth="95" styleClass="col-numero"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                    <VBox styleClass="card" spacing="10" prefWidth="310" minWidth="290">
                        <Label fx:id="lblDetalleTituloFGEM" text="Resultado de la campaña" styleClass="card-title" wrapText="true"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="detalleFGEM" spacing="10"/>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>

        <Tab text="Comparación">
            <VBox spacing="12" styleClass="tab-contenido">
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Campañas cerradas (cosechadas o perdidas) agrupadas por cultivo. Los promedios se ponderan por la superficie sembrada."/>
                <TableView fx:id="tablaComparacionFGEM" prefHeight="235" minHeight="190">
                    <columns>
                        <TableColumn fx:id="colCmpCultivoFGEM" text="Cultivo" prefWidth="160"/>
                        <TableColumn fx:id="colCmpCampaniasFGEM" text="Campañas" prefWidth="80" styleClass="col-numero"/>
                        <TableColumn fx:id="colCmpAreaFGEM" text="Área (ha)" prefWidth="75" styleClass="col-numero"/>
                        <TableColumn fx:id="colCmpRendimientoFGEM" text="kg/ha" prefWidth="80" styleClass="col-numero"/>
                        <TableColumn fx:id="colCmpAvanceFGEM" text="\% referencia" prefWidth="95" styleClass="col-numero"/>
                        <TableColumn fx:id="colCmpCostoFGEM" text="Costo/ha" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colCmpMargenFGEM" text="Margen/ha" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colCmpMejorFGEM" text="Mejor campaña" prefWidth="170"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <VBox styleClass="card" spacing="6" VBox.vgrow="ALWAYS">
                    <Label text="Rendimiento de cada campaña frente a su referencia (kg/ha)" styleClass="card-title"/>
                    <StackPane fx:id="graficoCampaniasFGEM" minHeight="200" VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </Tab>

        <Tab text="Parcelas">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkInactivasFGEM" text="Incluir desactivadas" minWidth="-Infinity" onAction="#cargarFGEM"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnEditarParcelaFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarParcelaFGEM">
                    </Button>
                    <Button fx:id="btnEstadoParcelaFGEM" text="Desactivar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#cambiarEstadoParcelaFGEM">
                    </Button>
                    <Button fx:id="btnNuevaParcelaFGEM" text="Nueva parcela" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevaParcelaFGEM">
                    </Button>
                </HBox>
                <TableView fx:id="tablaParcelasFGEM" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colParNombreFGEM" text="Parcela" prefWidth="180"/>
                        <TableColumn fx:id="colParAreaFGEM" text="Superficie" prefWidth="90" styleClass="col-numero"/>
                        <TableColumn fx:id="colParTenenciaFGEM" text="Tenencia" prefWidth="140"/>
                        <TableColumn fx:id="colParRiegoFGEM" text="Agua" prefWidth="80"/>
                        <TableColumn fx:id="colParUbicacionFGEM" text="Ubicación" prefWidth="220"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Las parcelas desactivadas conservan su historia, pero no se ofrecen para nuevas campañas. Si la parcela es propia, regístrala también como terreno en «Activos y deudas» para que su valor entre al balance."/>
            </VBox>
        </Tab>
    </TabPane>

    <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
           text="Superficies en hectáreas y cosechas en kilos. Lo no vendido (consumo, semilla, alimento para animales) se valoriza al precio en chacra de la campaña o, si no se indicó, al precio promedio de venta. Los costos de las campañas en curso entran al balance como «Cultivos en proceso»."/>
</VBox>
