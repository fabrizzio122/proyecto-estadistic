<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.PrediccionesControllerFGEM"
      spacing="14" styleClass="page">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Proyectar" styleClass="form-label"/>
        <ComboBox fx:id="cmbHorizonteFGEM" prefWidth="160"/>
        <ProgressIndicator fx:id="progresoFGEM" prefWidth="22" prefHeight="22" visible="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblHistoriaFGEM" styleClass="muted"/>
    </HBox>

    <HBox fx:id="indicadoresFGEM" spacing="16"/>

    <TabPane fx:id="pestanasFGEM" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">
        <Tab fx:id="tabVentasFGEM" text="Ventas netas"/>
        <Tab fx:id="tabUtilidadFGEM" text="Utilidad neta"/>
        <Tab fx:id="tabMetodosFGEM" text="Cómo se calcula"/>
    </TabPane>
</VBox>
