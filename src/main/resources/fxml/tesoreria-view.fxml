<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.TesoreriaControllerFGEM"
      spacing="14" styleClass="page">

    <!-- Indicadores principales -->
    <HBox fx:id="indicadoresFGEM" spacing="16"/>

    <TabPane fx:id="pestanasFGEM" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <!-- 1. Cuentas y movimientos entre cuentas -->
        <Tab text="Cuentas">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Dónde está el dinero" styleClass="card-title"/>
                    <CheckBox fx:id="chkInactivasFGEM" text="Incluir desactivadas" minWidth="-Infinity" onAction="#cargarFGEM"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnEditarCuentaFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarCuentaFGEM">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnActivarCuentaFGEM" text="Desactivar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#cambiarActivaFGEM">
                        <graphic><FontIcon iconLiteral="fth-power"/></graphic>
                    </Button>
                    <Button fx:id="btnNuevaCuentaFGEM" text="Nueva cuenta" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevaCuentaFGEM">
                        <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaCuentasFGEM" prefHeight="190" minHeight="140">
                    <columns>
                        <TableColumn fx:id="colCtaNombreFGEM" text="Cuenta" prefWidth="170"/>
                        <TableColumn fx:id="colCtaTipoFGEM" text="Tipo" prefWidth="170"/>
                        <TableColumn fx:id="colCtaNumeroFGEM" text="Número o celular" prefWidth="140"/>
                        <TableColumn fx:id="colCtaInicialFGEM" text="Saldo inicial" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colCtaEntradasFGEM" text="Entradas" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colCtaSalidasFGEM" text="Salidas" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colCtaSaldoFGEM" text="Saldo hoy" prefWidth="120" styleClass="col-numero"/>
                        <TableColumn fx:id="colCtaUltimoFGEM" text="Último movimiento" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Transferencias, aportes y retiros" styleClass="card-title"/>
                    <Label text="Desde" styleClass="form-label" minWidth="-Infinity"/>
                    <DatePicker fx:id="dpMovDesdeFGEM" prefWidth="130"/>
                    <Label text="Hasta" styleClass="form-label" minWidth="-Infinity"/>
                    <DatePicker fx:id="dpMovHastaFGEM" prefWidth="130"/>
                    <CheckBox fx:id="chkMovAnuladosFGEM" text="Incluir anulados" minWidth="-Infinity" onAction="#cargarMovimientosFGEM"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAnularMovimientoFGEM" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#anularMovimientoFGEM">
                        <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
                    </Button>
                    <Button fx:id="btnNuevoMovimientoFGEM" text="Mover dinero" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevoMovimientoFGEM">
                        <graphic><FontIcon iconLiteral="fth-repeat"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaMovimientosFGEM" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMovFechaFGEM" text="Fecha" prefWidth="95"/>
                        <TableColumn fx:id="colMovTipoFGEM" text="Tipo" prefWidth="170"/>
                        <TableColumn fx:id="colMovOrigenFGEM" text="Sale de" prefWidth="140"/>
                        <TableColumn fx:id="colMovDestinoFGEM" text="Entra a" prefWidth="140"/>
                        <TableColumn fx:id="colMovMontoFGEM" text="Monto" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colMovDescripcionFGEM" text="Descripción" prefWidth="240"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="El saldo de cada cuenta se calcula solo: saldo inicial + entradas − salidas. Las ventas y compras al contado, los ingresos y gastos, los préstamos, los pagos de deudas y las compras de activos indican su cuenta al registrarlos. Aquí se registra lo que solo cambia el dinero de lugar: depósitos, pases de Yape al banco, aportes o retiros del dueño."/>
            </VBox>
        </Tab>

        <!-- 2. Cuentas por cobrar y por pagar -->
        <Tab text="Por cobrar y por pagar">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <HBox styleClass="segmented">
                        <ToggleButton fx:id="tglCobrarFGEM" text="Por cobrar (ventas al crédito)" selected="true"/>
                        <ToggleButton fx:id="tglPagarFGEM" text="Por pagar (compras al crédito)"/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnVerPagosFGEM" text="Ver cobros" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#verPagosFGEM">
                        <graphic><FontIcon iconLiteral="fth-list"/></graphic>
                    </Button>
                    <Button fx:id="btnRegistrarPagoFGEM" text="Registrar cobro" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#registrarPagoFGEM">
                        <graphic><FontIcon iconLiteral="fth-check-circle"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaPendientesFGEM" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colPenNumeroFGEM" text="Número" prefWidth="95"/>
                        <TableColumn fx:id="colPenFechaFGEM" text="Fecha" prefWidth="90"/>
                        <TableColumn fx:id="colPenContraparteFGEM" text="Cliente" prefWidth="190"/>
                        <TableColumn fx:id="colPenTotalFGEM" text="Total" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colPenPagadoFGEM" text="Cobrado" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colPenPendienteFGEM" text="Pendiente" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colPenVenceFGEM" text="Vence" prefWidth="90"/>
                        <TableColumn fx:id="colPenEstadoFGEM" text="Situación" prefWidth="150"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label fx:id="lblPendientesFGEM" styleClass="muted"/>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Las ventas y compras al crédito se registran en «Ventas y compras» eligiendo «Al crédito». Aquí se registra cada cobro o pago parcial y la cuenta donde entró o de donde salió el dinero."/>
            </VBox>
        </Tab>

        <!-- 3. Estado de flujo de efectivo -->
        <Tab text="Flujo de efectivo">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Desde" styleClass="form-label" minWidth="-Infinity"/>
                    <DatePicker fx:id="dpFlujoDesdeFGEM" prefWidth="130"/>
                    <Label text="Hasta" styleClass="form-label" minWidth="-Infinity"/>
                    <DatePicker fx:id="dpFlujoHastaFGEM" prefWidth="130"/>
                    <Button text="Últimos 3 meses completos" styleClass="button-secondary" minWidth="-Infinity" onAction="#ultimosTresMesesFGEM"/>
                    <Button text="Este año" styleClass="button-secondary" minWidth="-Infinity" onAction="#esteAnioFGEM"/>
                </HBox>
                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <VBox spacing="8" prefWidth="470" minWidth="400">
                        <TableView fx:id="tablaFlujoFGEM" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
                            <columns>
                                <TableColumn fx:id="colFluConceptoFGEM" text="Concepto" prefWidth="300" sortable="false"/>
                                <TableColumn fx:id="colFluMontoFGEM" text="Monto" prefWidth="130" sortable="false" styleClass="col-numero"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                        </TableView>
                        <Label fx:id="lblFlujoFGEM" styleClass="hint" wrapText="true" minHeight="-Infinity"/>
                    </VBox>
                    <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Entradas, salidas y dinero al cierre de cada mes (últimos 12 meses)" styleClass="card-title"/>
                        <StackPane fx:id="graficoEvolucionFGEM" VBox.vgrow="ALWAYS" minHeight="240"/>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>

        <!-- 4. Proyección de caja -->
        <Tab text="Proyección de caja">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox fx:id="avisoProyeccionFGEM" styleClass="banner" spacing="14" alignment="CENTER_LEFT">
                    <FontIcon fx:id="iconoProyeccionFGEM" iconLiteral="fth-trending-up" styleClass="banner-icon"/>
                    <Label fx:id="lblProyeccionFGEM" wrapText="true" HBox.hgrow="ALWAYS" minHeight="-Infinity"/>
                </HBox>
                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Dinero disponible proyectado" styleClass="card-title"/>
                        <StackPane fx:id="graficoProyeccionFGEM" VBox.vgrow="ALWAYS" minHeight="240"/>
                    </VBox>
                    <VBox spacing="8" prefWidth="520" minWidth="440">
                        <TableView fx:id="tablaProyeccionFGEM" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
                            <columns>
                                <TableColumn fx:id="colProMesFGEM" text="Mes" prefWidth="150" sortable="false"/>
                                <TableColumn fx:id="colProOperacionFGEM" text="Operación" prefWidth="100" sortable="false" styleClass="col-numero"/>
                                <TableColumn fx:id="colProDeudasFGEM" text="Deudas" prefWidth="90" sortable="false" styleClass="col-numero"/>
                                <TableColumn fx:id="colProSaldoFGEM" text="Saldo" prefWidth="105" sortable="false" styleClass="col-numero"/>
                                <TableColumn fx:id="colProPesimistaFGEM" text="Pesimista" prefWidth="105" sortable="false" styleClass="col-numero"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                        </TableView>
                        <Label fx:id="lblMetodoFGEM" styleClass="hint" wrapText="true" minHeight="-Infinity"/>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
