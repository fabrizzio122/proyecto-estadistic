<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.InformesControllerFGEM"
      spacing="14" styleClass="page">

    <VBox spacing="8">
        <Label text="1. Elige el informe" styleClass="step-title"/>
        <HBox fx:id="tarjetasFGEM" spacing="14"/>
    </VBox>

    <VBox styleClass="card" spacing="10">
        <Label text="2. Elige el período y genera el archivo" styleClass="step-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Período" styleClass="form-label" minWidth="-Infinity"/>
            <ComboBox fx:id="cmbPeriodoFGEM" prefWidth="250" minWidth="200"/>
            <Label text="Desde" styleClass="form-label" minWidth="-Infinity"/>
            <DatePicker fx:id="dpDesdeFGEM" prefWidth="135" minWidth="120"/>
            <Label text="Hasta" styleClass="form-label" minWidth="-Infinity"/>
            <DatePicker fx:id="dpHastaFGEM" prefWidth="135" minWidth="120"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="progresoFGEM" prefWidth="22" prefHeight="22" visible="false"/>
            <Button fx:id="btnGenerarFGEM" text="Generar informe…" styleClass="button-primary" minWidth="-Infinity"
                    onAction="#generarFGEM">
            </Button>
        </HBox>
        <Label fx:id="lblResumenFGEM" styleClass="hint" wrapText="true" minHeight="-Infinity"/>
    </VBox>

    <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Informes generados" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnAbrirFGEM" text="Abrir" styleClass="button-secondary" minWidth="-Infinity" onAction="#abrirFGEM">
            </Button>
            <Button fx:id="btnCarpetaFGEM" text="Mostrar en la carpeta" styleClass="button-secondary" minWidth="-Infinity"
                    onAction="#abrirCarpetaFGEM">
            </Button>
        </HBox>
        <TableView fx:id="tablaHistorialFGEM" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
            <columns>
                <TableColumn fx:id="colFechaFGEM" text="Generado" prefWidth="130" minWidth="120"/>
                <TableColumn fx:id="colInformeFGEM" text="Informe" prefWidth="190" minWidth="150"/>
                <TableColumn fx:id="colPeriodoFGEM" text="Período" prefWidth="180" minWidth="150"/>
                <TableColumn fx:id="colUsuarioFGEM" text="Por" prefWidth="100" minWidth="80"/>
                <TableColumn fx:id="colArchivoFGEM" text="Archivo" prefWidth="320"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</VBox>
