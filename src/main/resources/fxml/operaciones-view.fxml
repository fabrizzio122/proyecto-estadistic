<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.OperacionesController"
      spacing="14" styleClass="page">

    <!-- Indicadores del período (ventas y compras) -->
    <HBox fx:id="indicadores" spacing="16"/>

    <!-- Fila 1: tipo de operación y acciones -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <HBox styleClass="segmented">
            <ToggleButton fx:id="tglVentas" text="Ventas" selected="true">
                <graphic><FontIcon iconLiteral="fth-trending-up"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="tglCompras" text="Compras">
                <graphic><FontIcon iconLiteral="fth-truck"/></graphic>
            </ToggleButton>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnDetalle" text="Ver detalle" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#verDetalle">
            <graphic><FontIcon iconLiteral="fth-eye"/></graphic>
        </Button>
        <Button fx:id="btnEditar" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#editar">
            <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
        </Button>
        <Button fx:id="btnAnular" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#anular">
            <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
        </Button>
        <Button fx:id="btnNueva" text="Nueva venta" styleClass="button-primary" minWidth="-Infinity"
                onAction="#nueva">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <!-- Fila 2: filtros -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Período" styleClass="form-label"/>
        <DatePicker fx:id="dpDesde" prefWidth="135"/>
        <Label text="al" styleClass="form-label"/>
        <DatePicker fx:id="dpHasta" prefWidth="135"/>
        <Button text="Este mes" styleClass="button-secondary" minWidth="-Infinity" onAction="#esteMes"/>
        <TextField fx:id="txtBuscar" promptText="Buscar por número, nombre o comprobante" prefWidth="270"
                   minWidth="140"/>
        <CheckBox fx:id="chkAnuladas" text="Incluir anuladas" minWidth="-Infinity" onAction="#cargar"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumero" text="Número" prefWidth="95"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
            <TableColumn fx:id="colContraparte" text="Cliente" prefWidth="170"/>
            <TableColumn fx:id="colComprobante" text="Comprobante" prefWidth="110"/>
            <TableColumn fx:id="colItems" text="Ítems" prefWidth="60" styleClass="col-numero"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="100" styleClass="col-numero"/>
            <TableColumn fx:id="colImpuesto" text="Impuesto" prefWidth="90" styleClass="col-numero"/>
            <TableColumn fx:id="colTotal" text="Total" prefWidth="100" styleClass="col-numero"/>
            <TableColumn fx:id="colMargen" text="Margen" prefWidth="95" styleClass="col-numero"/>
            <TableColumn fx:id="colPago" text="Pago" prefWidth="140"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblPie" styleClass="hint" wrapText="true"/>
</VBox>
