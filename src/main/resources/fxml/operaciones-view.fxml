<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.OperacionesControllerFGEM"
      spacing="14" styleClass="page">

    <!-- Indicadores del período (ventas y compras) -->
    <HBox fx:id="indicadoresFGEM" spacing="16"/>

    <!-- Fila 1: tipo de operación y acciones -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <HBox styleClass="segmented">
            <ToggleButton fx:id="tglVentasFGEM" text="Ventas" selected="true">
                <graphic><FontIcon iconLiteral="fth-trending-up"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="tglComprasFGEM" text="Compras">
                <graphic><FontIcon iconLiteral="fth-truck"/></graphic>
            </ToggleButton>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnDetalleFGEM" text="Ver detalle" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#verDetalleFGEM">
            <graphic><FontIcon iconLiteral="fth-eye"/></graphic>
        </Button>
        <Button fx:id="btnEditarFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#editarFGEM">
            <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
        </Button>
        <Button fx:id="btnAnularFGEM" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#anularFGEM">
            <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
        </Button>
        <Button fx:id="btnNuevaFGEM" text="Nueva venta" styleClass="button-primary" minWidth="-Infinity"
                onAction="#nuevaFGEM">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <!-- Fila 2: filtros -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Período" styleClass="form-label"/>
        <DatePicker fx:id="dpDesdeFGEM" prefWidth="135"/>
        <Label text="al" styleClass="form-label"/>
        <DatePicker fx:id="dpHastaFGEM" prefWidth="135"/>
        <Button text="Este mes" styleClass="button-secondary" minWidth="-Infinity" onAction="#esteMesFGEM"/>
        <TextField fx:id="txtBuscarFGEM" promptText="Buscar por número, nombre o comprobante" prefWidth="270"
                   minWidth="140"/>
        <CheckBox fx:id="chkAnuladasFGEM" text="Incluir anuladas" minWidth="-Infinity" onAction="#cargarFGEM"/>
    </HBox>

    <TableView fx:id="tablaFGEM" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumeroFGEM" text="Número" prefWidth="95"/>
            <TableColumn fx:id="colFechaFGEM" text="Fecha" prefWidth="90"/>
            <TableColumn fx:id="colContraparteFGEM" text="Cliente" prefWidth="170"/>
            <TableColumn fx:id="colComprobanteFGEM" text="Comprobante" prefWidth="110"/>
            <TableColumn fx:id="colItemsFGEM" text="Ítems" prefWidth="60" styleClass="col-numero"/>
            <TableColumn fx:id="colSubtotalFGEM" text="Subtotal" prefWidth="100" styleClass="col-numero"/>
            <TableColumn fx:id="colImpuestoFGEM" text="Impuesto" prefWidth="90" styleClass="col-numero"/>
            <TableColumn fx:id="colTotalFGEM" text="Total" prefWidth="100" styleClass="col-numero"/>
            <TableColumn fx:id="colMargenFGEM" text="Margen" prefWidth="95" styleClass="col-numero"/>
            <TableColumn fx:id="colPagoFGEM" text="Pago" prefWidth="140"/>
            <TableColumn fx:id="colEstadoFGEM" text="Estado" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblPieFGEM" styleClass="hint" wrapText="true"/>
</VBox>
