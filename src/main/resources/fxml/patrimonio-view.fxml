<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.PatrimonioControllerFGEM"
      spacing="14" styleClass="page">

    <HBox fx:id="indicadoresFGEM" spacing="16"/>

    <TabPane fx:id="pestanasFGEM" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <Tab text="Balance general">
            <HBox spacing="16" styleClass="tab-contenido">
                <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="520">
                    <TableView fx:id="tablaBalanceFGEM" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
                        <columns>
                            <TableColumn fx:id="colBalConceptoFGEM" text="Concepto" prefWidth="260" sortable="false"/>
                            <TableColumn fx:id="colBalMontoFGEM" text="Monto" prefWidth="130" sortable="false" styleClass="col-numero"/>
                            <TableColumn fx:id="colBalPorcentajeFGEM" text="\% del activo" prefWidth="100" sortable="false" styleClass="col-numero"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                    <Label fx:id="lblCorteFGEM" styleClass="hint" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="12" prefWidth="400" minWidth="340">
                    <VBox styleClass="card" spacing="10">
                        <Label text="Indicadores" styleClass="card-title"/>
                        <GridPane fx:id="gridIndicadoresFGEM" hgap="12" vgap="7"/>
                    </VBox>
                    <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS" minHeight="100">
                        <Label text="Lectura rápida" styleClass="card-title"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="lecturaFGEM" spacing="6"/>
                        </ScrollPane>
                    </VBox>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Activos">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarActivoFGEM" promptText="Buscar activo" prefWidth="220" minWidth="140"/>
                    <CheckBox fx:id="chkBajasFGEM" text="Incluir dados de baja" minWidth="-Infinity" onAction="#cargarFGEM"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnEditarActivoFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarActivoFGEM">
                    </Button>
                    <Button fx:id="btnBajaActivoFGEM" text="Dar de baja" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#darDeBajaFGEM">
                    </Button>
                    <Button fx:id="btnNuevoActivoFGEM" text="Nuevo activo" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevoActivoFGEM">
                    </Button>
                </HBox>
                <TableView fx:id="tablaActivosFGEM" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colActTipoFGEM" text="Tipo" prefWidth="150"/>
                        <TableColumn fx:id="colActDescripcionFGEM" text="Descripción" prefWidth="190"/>
                        <TableColumn fx:id="colActFechaFGEM" text="Fecha" prefWidth="90"/>
                        <TableColumn fx:id="colActValorFGEM" text="Valor" prefWidth="105" styleClass="col-numero"/>
                        <TableColumn fx:id="colActVidaFGEM" text="Vida útil" prefWidth="80" styleClass="col-numero"/>
                        <TableColumn fx:id="colActMensualFGEM" text="Por mes" prefWidth="85" styleClass="col-numero"/>
                        <TableColumn fx:id="colActDepreciacionFGEM" text="Dep. acumulada" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colActLibrosFGEM" text="Valor actual" prefWidth="110" styleClass="col-numero"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Montos sin impuestos. Los activos fijos se deprecian en línea recta por meses completos: valor actual = valor − depreciación acumulada. El inventario no se registra aquí (se calcula con el stock y el costo de los productos) y el dinero tampoco: está en «Tesorería»."/>
            </VBox>
        </Tab>

        <Tab text="Deudas">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarDeudaFGEM" promptText="Buscar acreedor" prefWidth="220" minWidth="140"/>
                    <CheckBox fx:id="chkAnuladasFGEM" text="Incluir anuladas" minWidth="-Infinity" onAction="#cargarFGEM"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnVerPagosFGEM" text="Ver pagos" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#verPagosFGEM">
                    </Button>
                    <Button fx:id="btnEditarDeudaFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarDeudaFGEM">
                    </Button>
                    <Button fx:id="btnAnularDeudaFGEM" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#anularDeudaFGEM">
                    </Button>
                    <Button fx:id="btnPagarFGEM" text="Registrar pago" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#registrarPagoFGEM">
                    </Button>
                    <Button fx:id="btnNuevaDeudaFGEM" text="Nueva deuda" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevaDeudaFGEM">
                    </Button>
                </HBox>
                <TableView fx:id="tablaDeudasFGEM" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDeuAcreedorFGEM" text="Acreedor" prefWidth="150"/>
                        <TableColumn fx:id="colDeuTipoFGEM" text="Tipo" prefWidth="150"/>
                        <TableColumn fx:id="colDeuFechaFGEM" text="Inicio" prefWidth="85"/>
                        <TableColumn fx:id="colDeuMontoFGEM" text="Monto" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colDeuSaldoFGEM" text="Saldo" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colDeuCuotaFGEM" text="Cuota" prefWidth="90" styleClass="col-numero"/>
                        <TableColumn fx:id="colDeuTasaFGEM" text="Tasa" prefWidth="70" styleClass="col-numero"/>
                        <TableColumn fx:id="colDeuVenceFGEM" text="Vence" prefWidth="85"/>
                        <TableColumn fx:id="colDeuEstadoFGEM" text="Estado" prefWidth="80"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Al registrar un pago se indica el capital (baja el saldo) y los intereses (se registran solos como gasto financiero), y la cuenta de la que salió el dinero. La parte que vence en los próximos 12 meses cuenta como deuda de corto plazo. Las compras al crédito a proveedores se ven en «Tesorería → Por cobrar y por pagar»."/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
