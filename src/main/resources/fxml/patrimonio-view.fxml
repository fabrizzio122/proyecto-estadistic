<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.PatrimonioController"
      spacing="14" styleClass="page">

    <!-- Indicadores principales -->
    <HBox fx:id="indicadores" spacing="16"/>

    <TabPane fx:id="pestanas" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <!-- 1. Balance general -->
        <Tab text="Balance general">
            <HBox spacing="16" styleClass="tab-contenido">
                <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="520">
                    <TableView fx:id="tablaBalance" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
                        <columns>
                            <TableColumn fx:id="colBalConcepto" text="Concepto" prefWidth="260" sortable="false"/>
                            <TableColumn fx:id="colBalMonto" text="Monto" prefWidth="130" sortable="false" styleClass="col-numero"/>
                            <TableColumn fx:id="colBalPorcentaje" text="\% del activo" prefWidth="100" sortable="false" styleClass="col-numero"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                    <Label fx:id="lblCorte" styleClass="hint" wrapText="true" minHeight="-Infinity"/>
                </VBox>
                <VBox spacing="12" prefWidth="400" minWidth="340">
                    <VBox styleClass="card" spacing="10">
                        <Label text="Indicadores" styleClass="card-title"/>
                        <GridPane fx:id="gridIndicadores" hgap="12" vgap="7"/>
                    </VBox>
                    <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS" minHeight="100">
                        <Label text="Lectura rápida" styleClass="card-title"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="lectura" spacing="6"/>
                        </ScrollPane>
                    </VBox>
                </VBox>
            </HBox>
        </Tab>

        <!-- 2. Activos -->
        <Tab text="Activos">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarActivo" promptText="Buscar activo" prefWidth="220" minWidth="140"/>
                    <CheckBox fx:id="chkBajas" text="Incluir dados de baja" minWidth="-Infinity" onAction="#cargar"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnEditarActivo" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarActivo">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnBajaActivo" text="Dar de baja" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#darDeBaja">
                        <graphic><FontIcon iconLiteral="fth-archive"/></graphic>
                    </Button>
                    <Button fx:id="btnNuevoActivo" text="Nuevo activo" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevoActivo">
                        <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaActivos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colActTipo" text="Tipo" prefWidth="150"/>
                        <TableColumn fx:id="colActDescripcion" text="Descripción" prefWidth="190"/>
                        <TableColumn fx:id="colActFecha" text="Fecha" prefWidth="90"/>
                        <TableColumn fx:id="colActValor" text="Valor" prefWidth="105" styleClass="col-numero"/>
                        <TableColumn fx:id="colActVida" text="Vida útil" prefWidth="80" styleClass="col-numero"/>
                        <TableColumn fx:id="colActMensual" text="Por mes" prefWidth="85" styleClass="col-numero"/>
                        <TableColumn fx:id="colActDepreciacion" text="Dep. acumulada" prefWidth="110" styleClass="col-numero"/>
                        <TableColumn fx:id="colActLibros" text="Valor actual" prefWidth="110" styleClass="col-numero"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Montos sin impuestos. Los activos fijos se deprecian en línea recta por meses completos: valor actual = valor − depreciación acumulada. El inventario no se registra aquí (se calcula con el stock y el costo de los productos) y el dinero tampoco: está en «Tesorería»."/>
            </VBox>
        </Tab>

        <!-- 3. Deudas -->
        <Tab text="Deudas">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtBuscarDeuda" promptText="Buscar acreedor" prefWidth="220" minWidth="140"/>
                    <CheckBox fx:id="chkAnuladas" text="Incluir anuladas" minWidth="-Infinity" onAction="#cargar"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnVerPagos" text="Ver pagos" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#verPagos">
                        <graphic><FontIcon iconLiteral="fth-list"/></graphic>
                    </Button>
                    <Button fx:id="btnEditarDeuda" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarDeuda">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnAnularDeuda" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#anularDeuda">
                        <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
                    </Button>
                    <Button fx:id="btnPagar" text="Registrar pago" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#registrarPago">
                        <graphic><FontIcon iconLiteral="fth-check-circle"/></graphic>
                    </Button>
                    <Button fx:id="btnNuevaDeuda" text="Nueva deuda" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevaDeuda">
                        <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaDeudas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDeuAcreedor" text="Acreedor" prefWidth="150"/>
                        <TableColumn fx:id="colDeuTipo" text="Tipo" prefWidth="150"/>
                        <TableColumn fx:id="colDeuFecha" text="Inicio" prefWidth="85"/>
                        <TableColumn fx:id="colDeuMonto" text="Monto" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colDeuSaldo" text="Saldo" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colDeuCuota" text="Cuota" prefWidth="90" styleClass="col-numero"/>
                        <TableColumn fx:id="colDeuTasa" text="Tasa" prefWidth="70" styleClass="col-numero"/>
                        <TableColumn fx:id="colDeuVence" text="Vence" prefWidth="85"/>
                        <TableColumn fx:id="colDeuEstado" text="Estado" prefWidth="80"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Al registrar un pago se indica el capital (baja el saldo) y los intereses (se registran solos como gasto financiero), y la cuenta de la que salió el dinero. La parte que vence en los próximos 12 meses cuenta como deuda de corto plazo. Las compras al crédito a proveedores se ven en «Tesorería → Por cobrar y por pagar»."/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
