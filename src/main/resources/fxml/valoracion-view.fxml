<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.ValoracionController"
      spacing="14" styleClass="page">

    <!-- Supuestos -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Tasa de descuento" styleClass="form-label" minWidth="-Infinity"/>
        <TextField fx:id="txtTasa" prefWidth="70" promptText="20"/>
        <Label text="\%" styleClass="muted"/>
        <Label text="Crecimiento anual" styleClass="form-label" minWidth="-Infinity"/>
        <TextField fx:id="txtCrecimiento" prefWidth="70" promptText="0"/>
        <Label text="\%" styleClass="muted"/>
        <Button text="Calcular" styleClass="button-primary" minWidth="-Infinity" onAction="#calcular">
            <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
        </Button>
        <Button text="Valores sugeridos" styleClass="button-secondary" minWidth="-Infinity" onAction="#usarSugeridos"/>
        <ProgressIndicator fx:id="progreso" prefWidth="22" prefHeight="22" visible="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnExportar" text="Informe PDF" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#exportar">
            <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
        </Button>
    </HBox>
    <Label fx:id="lblSupuestos" styleClass="hint" wrapText="true" minHeight="-Infinity"/>

    <!-- Indicadores principales -->
    <HBox fx:id="indicadores" spacing="16"/>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="16">
            <HBox spacing="16">
                <VBox styleClass="card" spacing="10" HBox.hgrow="ALWAYS" prefWidth="420">
                    <Label text="Métodos de valoración" styleClass="card-title"/>
                    <GridPane fx:id="gridMetodos" hgap="12" vgap="8"/>
                    <StackPane fx:id="graficoMetodos" minHeight="200" prefHeight="200"/>
                </VBox>
                <VBox spacing="16" prefWidth="420" minWidth="360">
                    <VBox styleClass="card" spacing="10">
                        <Label text="Proyección de flujos para el dueño" styleClass="card-title"/>
                        <GridPane fx:id="gridProyeccion" hgap="14" vgap="6"/>
                    </VBox>
                    <VBox styleClass="card" spacing="10">
                        <Label text="Sensibilidad (flujos descontados)" styleClass="card-title"/>
                        <Label text="Cómo cambia el valor si la tasa o el crecimiento son distintos." styleClass="hint" wrapText="true"/>
                        <GridPane fx:id="gridSensibilidad" hgap="14" vgap="6"/>
                    </VBox>
                </VBox>
            </HBox>
            <VBox styleClass="card" spacing="8">
                <Label text="Lectura" styleClass="card-title"/>
                <VBox fx:id="lectura" spacing="6"/>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="La tasa de descuento es la rentabilidad anual que exigiría alguien por invertir en este negocio: cuanto más riesgoso, más alta (20 % es habitual en una micro o pequeña empresa). Es una estimación con los datos registrados; no reemplaza una tasación profesional."/>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
