<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.businessanalyzer.controller.DashboardControllerFGEM"
            fitToWidth="true" styleClass="page-scroll">

    <VBox spacing="16" styleClass="page">

        <HBox fx:id="bannerEmpresaFGEM" styleClass="banner" spacing="14" alignment="CENTER_LEFT"
              visible="false" managed="false">
            <FontIcon fx:id="iconoBannerFGEM" iconLiteral="fth-info" styleClass="banner-icon" visible="false" managed="false"/>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label fx:id="lblBannerTituloFGEM" styleClass="step-title"/>
                <Label fx:id="lblBannerDetalleFGEM" wrapText="true"/>
            </VBox>
        </HBox>

        <VBox fx:id="contenidoFGEM" spacing="16">
            <HBox fx:id="indicadoresFGEM" spacing="16"/>

            <HBox spacing="16">
                <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS" prefWidth="640">
                    <Label text="Ventas y utilidad por mes" styleClass="card-title"/>
                    <StackPane fx:id="graficoFGEM" prefHeight="300" minHeight="260"/>
                </VBox>
                <VBox styleClass="card" spacing="8" prefWidth="340" minWidth="300" maxWidth="380">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Avisos" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSugerenciasFGEM" text="Ver sugerencias" styleClass="button-link"
                                minWidth="-Infinity" onAction="#irSugerenciasFGEM"/>
                    </HBox>
                    <VBox fx:id="avisosFGEM" spacing="8"/>
                </VBox>
            </HBox>

            <VBox styleClass="card" spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Productos del mes" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnAnalisisFGEM" text="Análisis financiero" styleClass="button-link"
                            minWidth="-Infinity" onAction="#irAnalisisFGEM"/>
                </HBox>
                <TableView fx:id="tablaProductosFGEM" prefHeight="250">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colProductoFGEM" text="Producto" prefWidth="300"/>
                        <TableColumn fx:id="colCantidadFGEM" text="Cantidad" prefWidth="100" styleClass="col-numero"/>
                        <TableColumn fx:id="colVentasFGEM" text="Ventas" prefWidth="140" styleClass="col-numero"/>
                        <TableColumn fx:id="colMargenFGEM" text="Margen" prefWidth="140" styleClass="col-numero"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
