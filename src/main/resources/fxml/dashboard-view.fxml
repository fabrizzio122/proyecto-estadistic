<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.businessanalyzer.controller.DashboardController"
            fitToWidth="true" styleClass="page-scroll">

    <VBox spacing="20" styleClass="page">

        <!-- Empresa activa (o aviso si no hay ninguna) -->
        <HBox fx:id="bannerEmpresa" styleClass="banner" spacing="14" alignment="CENTER_LEFT">
            <FontIcon fx:id="iconoBanner" styleClass="banner-icon"/>
            <VBox spacing="2">
                <Label fx:id="lblBannerTitulo" styleClass="step-title"/>
                <Label fx:id="lblBannerDetalle" styleClass="muted" wrapText="true"/>
            </VBox>
        </HBox>

        <!-- Tarjetas de indicadores (se crean en DashboardController) -->
        <HBox fx:id="indicadores" spacing="16"/>

        <HBox spacing="16">
            <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS">
                <Label text="Primeros pasos" styleClass="card-title"/>
                <Label styleClass="muted" wrapText="true"
                       text="Los indicadores se calcularán automáticamente a partir de la información que registres. Este es el orden recomendado:"/>
                <VBox fx:id="pasos" spacing="14"/>
            </VBox>

            <VBox styleClass="card" spacing="16" prefWidth="400" minWidth="340">
                <Label text="Estado del sistema" styleClass="card-title"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label text="Versión" styleClass="info-key"/>
                    <Label fx:id="lblVersion" styleClass="info-value" GridPane.columnIndex="1"/>
                    <Label text="Esquema BD" styleClass="info-key" GridPane.rowIndex="1"/>
                    <Label fx:id="lblEsquema" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="Base de datos" styleClass="info-key" GridPane.rowIndex="2"/>
                    <Label fx:id="lblBaseDatos" styleClass="info-value" wrapText="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="Java" styleClass="info-key" GridPane.rowIndex="3"/>
                    <Label fx:id="lblJava" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <Label text="JavaFX" styleClass="info-key" GridPane.rowIndex="4"/>
                    <Label fx:id="lblJavaFx" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>
                <Label text="Pruebas de interfaz" styleClass="info-key"/>
                <HBox spacing="10">
                    <Button text="Notificaciones" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#probarNotificaciones"/>
                    <Button text="Confirmación" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#probarConfirmacion"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
