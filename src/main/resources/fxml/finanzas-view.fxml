<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.FinanzasControllerFGEM"
      spacing="14" styleClass="page">

    <!-- Indicadores del período -->
    <HBox fx:id="indicadoresFGEM" spacing="16"/>

    <!-- Fila 1: filtros -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Período" styleClass="form-label"/>
        <DatePicker fx:id="dpDesdeFGEM" prefWidth="135"/>
        <Label text="al" styleClass="form-label"/>
        <DatePicker fx:id="dpHastaFGEM" prefWidth="135"/>
        <Button text="Este mes" styleClass="button-secondary" minWidth="-Infinity" onAction="#esteMesFGEM"/>
        <ComboBox fx:id="cmbTipoFGEM" prefWidth="130" minWidth="130"/>
        <TextField fx:id="txtBuscarFGEM" promptText="Buscar descripción o comprobante" prefWidth="230" minWidth="140"/>
        <CheckBox fx:id="chkAnuladosFGEM" text="Incluir anulados" minWidth="-Infinity" onAction="#cargarFGEM"/>
    </HBox>

    <!-- Fila 2: acciones -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnCopiarFGEM" text="Copiar gastos fijos del mes anterior" styleClass="button-secondary"
                minWidth="-Infinity" onAction="#copiarFijosFGEM">
            <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEditarFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity" onAction="#editarFGEM">
            <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
        </Button>
        <Button fx:id="btnAnularFGEM" text="Anular" styleClass="button-secondary" minWidth="-Infinity" onAction="#anularFGEM">
            <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
        </Button>
        <Button fx:id="btnNuevoIngresoFGEM" text="Nuevo ingreso" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#nuevoIngresoFGEM">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
        <Button fx:id="btnNuevoGastoFGEM" text="Nuevo gasto" styleClass="button-primary" minWidth="-Infinity"
                onAction="#nuevoGastoFGEM">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <!-- Movimientos (izquierda) y gastos por categoría (derecha) -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaFGEM" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFechaFGEM" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colCategoriaFGEM" text="Categoría" prefWidth="165"/>
                <TableColumn fx:id="colDescripcionFGEM" text="Descripción" prefWidth="180"/>
                <TableColumn fx:id="colComportamientoFGEM" text="Tipo de costo" prefWidth="95"/>
                <TableColumn fx:id="colCuentaFGEM" text="Cuenta" prefWidth="100"/>
                <TableColumn fx:id="colMontoFGEM" text="Monto" prefWidth="105" styleClass="col-numero"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>

        <VBox styleClass="card" spacing="12" prefWidth="300" minWidth="280">
            <Label text="Gastos por categoría" styleClass="card-title"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="desgloseFGEM" spacing="12"/>
            </ScrollPane>
        </VBox>
    </HBox>

    <Label styleClass="hint" wrapText="true"
           text="Montos sin impuestos. Aquí van los ingresos y gastos que no son compras ni ventas de mercadería. Fijo: no cambia con el volumen de ventas; variable: sube o baja con las ventas."/>
</VBox>
