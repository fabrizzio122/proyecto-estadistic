<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.FinanzasController"
      spacing="14" styleClass="page">

    <!-- Indicadores del período -->
    <HBox fx:id="indicadores" spacing="16"/>

    <!-- Fila 1: filtros -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Período" styleClass="form-label"/>
        <DatePicker fx:id="dpDesde" prefWidth="135"/>
        <Label text="al" styleClass="form-label"/>
        <DatePicker fx:id="dpHasta" prefWidth="135"/>
        <Button text="Este mes" styleClass="button-secondary" minWidth="-Infinity" onAction="#esteMes"/>
        <ComboBox fx:id="cmbTipo" prefWidth="130" minWidth="130"/>
        <TextField fx:id="txtBuscar" promptText="Buscar descripción o comprobante" prefWidth="230" minWidth="140"/>
        <CheckBox fx:id="chkAnulados" text="Incluir anulados" minWidth="-Infinity" onAction="#cargar"/>
    </HBox>

    <!-- Fila 2: acciones -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="btnCopiar" text="Copiar gastos fijos del mes anterior" styleClass="button-secondary"
                minWidth="-Infinity" onAction="#copiarFijos">
            <graphic><FontIcon iconLiteral="fth-copy"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEditar" text="Editar" styleClass="button-secondary" minWidth="-Infinity" onAction="#editar">
            <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
        </Button>
        <Button fx:id="btnAnular" text="Anular" styleClass="button-secondary" minWidth="-Infinity" onAction="#anular">
            <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
        </Button>
        <Button fx:id="btnNuevoIngreso" text="Nuevo ingreso" styleClass="button-secondary" minWidth="-Infinity"
                onAction="#nuevoIngreso">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
        <Button fx:id="btnNuevoGasto" text="Nuevo gasto" styleClass="button-primary" minWidth="-Infinity"
                onAction="#nuevoGasto">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <!-- Movimientos (izquierda) y gastos por categoría (derecha) -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabla" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="165"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="180"/>
                <TableColumn fx:id="colComportamiento" text="Tipo de costo" prefWidth="95"/>
                <TableColumn fx:id="colMonto" text="Monto" prefWidth="105" styleClass="col-numero"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>

        <VBox styleClass="card" spacing="12" prefWidth="300" minWidth="280">
            <Label text="Gastos por categoría" styleClass="card-title"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="desglose" spacing="12"/>
            </ScrollPane>
        </VBox>
    </HBox>

    <Label styleClass="hint" wrapText="true"
           text="Montos sin impuestos. Aquí van los ingresos y gastos que no son compras ni ventas de mercadería. Fijo: no cambia con el volumen de ventas; variable: sube o baja con las ventas."/>
</VBox>
