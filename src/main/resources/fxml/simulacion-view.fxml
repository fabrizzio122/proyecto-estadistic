<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.SimulacionControllerFGEM"
      spacing="14" styleClass="page">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Base" styleClass="form-label"/>
        <ComboBox fx:id="cmbBaseFGEM" prefWidth="270" minWidth="240"/>
        <Label fx:id="lblBaseFGEM" styleClass="muted"/>
        <ProgressIndicator fx:id="progresoFGEM" prefWidth="22" prefHeight="22" visible="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Restablecer" styleClass="button-secondary" minWidth="-Infinity" onAction="#restablecerFGEM">
        </Button>
        <Button text="Guardar escenario" styleClass="button-primary" minWidth="-Infinity" onAction="#guardarEscenarioFGEM">
        </Button>
    </HBox>

    <HBox fx:id="indicadoresFGEM" spacing="16"/>

    <TabPane fx:id="pestanasFGEM" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <Tab text="Simulador">
            <HBox spacing="16" styleClass="tab-contenido">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" prefWidth="390" minWidth="350">
                    <VBox fx:id="panelSupuestosFGEM" styleClass="card" spacing="12"/>
                </ScrollPane>
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <VBox styleClass="card" spacing="6" VBox.vgrow="ALWAYS">
                        <Label text="Base frente a escenario (montos mensuales)" styleClass="card-title"/>
                        <TableView fx:id="tablaResultadosFGEM" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
                            <columns>
                                <TableColumn fx:id="colConceptoFGEM" text="Concepto" prefWidth="215" minWidth="205" sortable="false"/>
                                <TableColumn fx:id="colBaseFGEM" text="Base" prefWidth="110" sortable="false" styleClass="col-numero"/>
                                <TableColumn fx:id="colEscenarioFGEM" text="Escenario" prefWidth="110" sortable="false" styleClass="col-numero"/>
                                <TableColumn fx:id="colVariacionFGEM" text="Diferencia" prefWidth="110" sortable="false" styleClass="col-numero"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Sensibilidad y metas">
            <HBox spacing="16" styleClass="tab-contenido">
                <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="¿Qué variable pesa más en la utilidad?" styleClass="card-title"/>
                    <StackPane fx:id="contenedorTornadoFGEM" VBox.vgrow="ALWAYS" minHeight="200"/>
                    <VBox fx:id="lecturaSensibilidadFGEM" spacing="4"/>
                </VBox>
                <VBox styleClass="card" spacing="10" prefWidth="360" minWidth="320">
                    <Label text="Meta de utilidad" styleClass="card-title"/>
                    <Label styleClass="muted" wrapText="true" minHeight="-Infinity"
                           text="¿Cuánto quieres ganar al mes? El sistema calcula qué tendrías que cambiar, partiendo del escenario actual."/>
                    <Label text="Utilidad neta mensual deseada" styleClass="form-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="txtMetaFGEM" promptText="Ej.: 5000" HBox.hgrow="ALWAYS" onAction="#calcularMetaFGEM"/>
                        <Button text="Calcular" styleClass="button-primary" minWidth="-Infinity" onAction="#calcularMetaFGEM"/>
                    </HBox>
                    <VBox fx:id="resultadoMetaFGEM" spacing="8"/>
                </VBox>
            </HBox>
        </Tab>

        <Tab text="Comparar escenarios">
            <HBox spacing="16" styleClass="tab-contenido">
                <VBox styleClass="card" spacing="10" prefWidth="250" minWidth="230">
                    <Label text="Escenarios guardados" styleClass="card-title"/>
                    <ListView fx:id="listaEscenariosFGEM" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8">
                        <Button fx:id="btnCargarFGEM" text="Cargar" styleClass="button-secondary" onAction="#cargarEscenarioFGEM">
                            <tooltip><Tooltip text="Llevar los supuestos de este escenario al simulador"/></tooltip>
                        </Button>
                        <Button fx:id="btnEliminarFGEM" text="Eliminar" styleClass="button-secondary" onAction="#eliminarEscenarioFGEM"/>
                    </HBox>
                </VBox>
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <TableView fx:id="tablaComparacionFGEM" styleClass="tabla-compacta" prefHeight="212" minHeight="212">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                    <VBox styleClass="card" spacing="6" VBox.vgrow="ALWAYS">
                        <Label text="Base, escenario actual y escenarios guardados" styleClass="card-title"/>
                        <StackPane fx:id="contenedorComparacionFGEM" VBox.vgrow="ALWAYS" minHeight="100"/>
                    </VBox>
                </VBox>
            </HBox>
        </Tab>
    </TabPane>
</VBox>
