<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.SimulacionController"
      spacing="14" styleClass="page">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Base" styleClass="form-label"/>
        <ComboBox fx:id="cmbBase" prefWidth="270" minWidth="240"/>
        <Label fx:id="lblBase" styleClass="muted"/>
        <ProgressIndicator fx:id="progreso" prefWidth="22" prefHeight="22" visible="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Restablecer" styleClass="button-secondary" minWidth="-Infinity" onAction="#restablecer">
            <graphic><FontIcon iconLiteral="fth-rotate-ccw"/></graphic>
        </Button>
        <Button text="Guardar escenario" styleClass="button-primary" minWidth="-Infinity" onAction="#guardarEscenario">
            <graphic><FontIcon iconLiteral="fth-save"/></graphic>
        </Button>
    </HBox>

    <HBox fx:id="indicadores" spacing="16"/>

    <TabPane fx:id="pestanas" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <!-- 1. Simulador -->
        <Tab text="Simulador">
            <HBox spacing="16" styleClass="tab-contenido">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" prefWidth="390" minWidth="350">
                    <VBox fx:id="panelSupuestos" styleClass="card" spacing="12"/>
                </ScrollPane>
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <VBox styleClass="card" spacing="6" VBox.vgrow="ALWAYS">
                        <Label text="Base frente a escenario (montos mensuales)" styleClass="card-title"/>
                        <TableView fx:id="tablaResultados" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
                            <columns>
                                <TableColumn fx:id="colConcepto" text="Concepto" prefWidth="215" minWidth="205" sortable="false"/>
                                <TableColumn fx:id="colBase" text="Base" prefWidth="110" sortable="false" styleClass="col-numero"/>
                                <TableColumn fx:id="colEscenario" text="Escenario" prefWidth="110" sortable="false" styleClass="col-numero"/>
                                <TableColumn fx:id="colVariacion" text="Diferencia" prefWidth="110" sortable="false" styleClass="col-numero"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </VBox>
            </HBox>
        </Tab>

        <!-- 2. Sensibilidad y meta -->
        <Tab text="Sensibilidad y metas">
            <HBox spacing="16" styleClass="tab-contenido">
                <VBox styleClass="card" spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="¿Qué variable pesa más en la utilidad?" styleClass="card-title"/>
                    <StackPane fx:id="contenedorTornado" VBox.vgrow="ALWAYS" minHeight="200"/>
                    <VBox fx:id="lecturaSensibilidad" spacing="4"/>
                </VBox>
                <VBox styleClass="card" spacing="10" prefWidth="360" minWidth="320">
                    <Label text="Meta de utilidad" styleClass="card-title"/>
                    <Label styleClass="muted" wrapText="true" minHeight="-Infinity"
                           text="¿Cuánto quieres ganar al mes? El sistema calcula qué tendrías que cambiar, partiendo del escenario actual."/>
                    <Label text="Utilidad neta mensual deseada" styleClass="form-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="txtMeta" promptText="Ej.: 5000" HBox.hgrow="ALWAYS" onAction="#calcularMeta"/>
                        <Button text="Calcular" styleClass="button-primary" minWidth="-Infinity" onAction="#calcularMeta"/>
                    </HBox>
                    <VBox fx:id="resultadoMeta" spacing="8"/>
                </VBox>
            </HBox>
        </Tab>

        <!-- 3. Comparar escenarios guardados -->
        <Tab text="Comparar escenarios">
            <HBox spacing="16" styleClass="tab-contenido">
                <VBox styleClass="card" spacing="10" prefWidth="250" minWidth="230">
                    <Label text="Escenarios guardados" styleClass="card-title"/>
                    <ListView fx:id="listaEscenarios" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="8">
                        <Button fx:id="btnCargar" text="Cargar" styleClass="button-secondary" onAction="#cargarEscenario">
                            <tooltip><Tooltip text="Llevar los supuestos de este escenario al simulador"/></tooltip>
                        </Button>
                        <Button fx:id="btnEliminar" text="Eliminar" styleClass="button-secondary" onAction="#eliminarEscenario"/>
                    </HBox>
                </VBox>
                <VBox spacing="12" HBox.hgrow="ALWAYS">
                    <TableView fx:id="tablaComparacion" styleClass="tabla-compacta" prefHeight="212" minHeight="212">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                    <VBox styleClass="card" spacing="6" VBox.vgrow="ALWAYS">
                        <Label text="Base, escenario actual y escenarios guardados" styleClass="card-title"/>
                        <StackPane fx:id="contenedorComparacion" VBox.vgrow="ALWAYS" minHeight="100"/>
                    </VBox>
                </VBox>
            </HBox>
        </Tab>
    </TabPane>
</VBox>
