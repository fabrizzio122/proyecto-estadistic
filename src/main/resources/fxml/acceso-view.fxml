<?xml version="1.0" encoding="UTF-8"?>

<?import com.businessanalyzer.ui.PanelMarcaFGEM?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Inicio de sesión: a la izquierda el panel de marca con la lámpara; a la derecha el formulario. -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.AccesoControllerFGEM"
      styleClass="pantalla-acceso">

    <PanelMarcaFGEM fx:id="panelMarcaFGEM" HBox.hgrow="ALWAYS" prefWidth="640"/>

    <StackPane HBox.hgrow="ALWAYS" prefWidth="640" minWidth="440" styleClass="acceso-formulario">
        <padding><Insets top="40" right="48" bottom="40" left="48"/></padding>

        <VBox fx:id="formularioFGEM" spacing="20" maxWidth="380" maxHeight="-Infinity">
            <VBox spacing="6">
                <Label text="Hola de nuevo" styleClass="acceso-titulo"/>
                <Label fx:id="lblSubtituloFGEM" text="Elige tu usuario para continuar." styleClass="acceso-subtitulo"/>
            </VBox>

            <VBox fx:id="listaUsuariosFGEM" spacing="10"/>

            <VBox fx:id="campoUsuarioFGEM" spacing="8">
                <Label text="Usuario" styleClass="form-label"/>
                <TextField fx:id="txtUsuarioFGEM" promptText="Nombre de usuario" onAction="#enfocarPasswordFGEM"
                           styleClass="campo-acceso"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Contraseña" styleClass="form-label"/>
                <StackPane alignment="CENTER_RIGHT">
                    <PasswordField fx:id="txtPasswordFGEM" onAction="#ingresarFGEM" styleClass="campo-acceso, campo-con-boton"/>
                    <TextField fx:id="txtPasswordVisibleFGEM" onAction="#ingresarFGEM" styleClass="campo-acceso, campo-con-boton"
                               visible="false"/>
                    <Button fx:id="btnMostrarFGEM" text="Mostrar" styleClass="boton-mostrar" onAction="#alternarPasswordFGEM"
                            focusTraversable="false">
                        <StackPane.margin><Insets right="8"/></StackPane.margin>
                    </Button>
                </StackPane>
            </VBox>

            <CheckBox fx:id="chkRecordarFGEM" text="Recordarme en este equipo"/>

            <Label fx:id="lblErrorFGEM" styleClass="form-error" wrapText="true" maxWidth="1.7976931348623157E308"
                   visible="false" managed="false"/>

            <StackPane>
                <Button fx:id="btnIngresarFGEM" text="Ingresar" styleClass="button-primary, acceso-boton"
                        defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#ingresarFGEM"/>
                <ProgressIndicator fx:id="progresoFGEM" prefWidth="24" prefHeight="24" visible="false"
                                   StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin><Insets right="16"/></StackPane.margin>
                </ProgressIndicator>
            </StackPane>

            <Label fx:id="lblVersionFGEM" styleClass="acceso-version" maxWidth="1.7976931348623157E308"/>
        </VBox>
    </StackPane>
</HBox>
