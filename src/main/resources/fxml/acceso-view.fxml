<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import com.businessanalyzer.config.VersionApp?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Pantalla de inicio de sesion. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.businessanalyzer.controller.AccesoController"
           styleClass="login-bg">

    <VBox styleClass="login-card" spacing="16" maxWidth="400" maxHeight="-Infinity">
        <HBox styleClass="login-brand">
            <FontIcon iconLiteral="fth-bar-chart-2" styleClass="brand-icon"/>
            <VBox>
                <Label text="Business Analyzer" styleClass="brand-title"/>
                <Label styleClass="brand-subtitle">
                    <text><VersionApp fx:constant="SUBTITULO"/></text>
                </Label>
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label text="Iniciar sesión" styleClass="login-title"/>
            <Label text="Ingresa tus credenciales para continuar." styleClass="muted"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Usuario" styleClass="form-label"/>
            <TextField fx:id="txtUsuario" promptText="Nombre de usuario" onAction="#enfocarPassword"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Contraseña" styleClass="form-label"/>
            <PasswordField fx:id="txtPassword" promptText="Contraseña" onAction="#ingresar"/>
        </VBox>

        <Label fx:id="lblError" styleClass="form-error" wrapText="true" maxWidth="1.7976931348623157E308"
               visible="false" managed="false"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="btnIngresar" text="Ingresar" styleClass="button-primary, login-button"
                    defaultButton="true" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                    onAction="#ingresar"/>
            <ProgressIndicator fx:id="progreso" prefWidth="26" prefHeight="26" visible="false" managed="false"/>
        </HBox>
    </VBox>
</StackPane>
