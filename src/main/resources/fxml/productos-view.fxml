<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.businessanalyzer.controller.ProductosControllerFGEM"
         tabClosingPolicy="UNAVAILABLE">

    <Tab text="Productos y servicios">
        <VBox spacing="14" styleClass="page">
            <HBox fx:id="indicadoresFGEM" spacing="16"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscarFGEM" promptText="Buscar por código o nombre" prefWidth="210" minWidth="120"/>
                <ComboBox fx:id="cmbFiltroTipoFGEM" prefWidth="155" minWidth="155"/>
                <ComboBox fx:id="cmbFiltroCategoriaFGEM" prefWidth="190" minWidth="190"/>
                <CheckBox fx:id="chkArchivadosFGEM" text="Archivados" minWidth="-Infinity" onAction="#cargarFGEM"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEditarFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                        onAction="#editarFGEM">
                </Button>
                <MenuButton fx:id="menuAccionesFGEM" text="Acciones" styleClass="button-secondary" minWidth="-Infinity">
                    <items>
                        <MenuItem fx:id="itemHistorialFGEM" text="Historial de precios" onAction="#verHistorialFGEM"/>
                        <MenuItem fx:id="itemEstadoFGEM" text="Archivar" onAction="#cambiarEstadoFGEM"/>
                    </items>
                </MenuButton>
                <Button fx:id="btnNuevoFGEM" text="Nuevo" styleClass="button-primary" minWidth="-Infinity"
                        onAction="#nuevoFGEM">
                </Button>
            </HBox>

            <TableView fx:id="tablaFGEM" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigoFGEM" text="Código" prefWidth="80"/>
                    <TableColumn fx:id="colNombreFGEM" text="Nombre" prefWidth="195"/>
                    <TableColumn fx:id="colTipoFGEM" text="Tipo" prefWidth="80"/>
                    <TableColumn fx:id="colCategoriaFGEM" text="Categoría" prefWidth="120"/>
                    <TableColumn fx:id="colUnidadFGEM" text="Unidad" prefWidth="75"/>
                    <TableColumn fx:id="colStockFGEM" text="Stock" prefWidth="70" styleClass="col-numero"/>
                    <TableColumn fx:id="colCostoFGEM" text="Costo" prefWidth="95" styleClass="col-numero"/>
                    <TableColumn fx:id="colPrecioFGEM" text="Precio" prefWidth="95" styleClass="col-numero"/>
                    <TableColumn fx:id="colMargenFGEM" text="Margen" prefWidth="95" styleClass="col-numero"/>
                    <TableColumn fx:id="colMargenPctFGEM" text="Margen %" prefWidth="85" styleClass="col-numero"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="lblNotaFGEM" styleClass="hint" wrapText="true"
                   text="Precios sin impuestos. Margen % = (precio − costo) ÷ precio. En rojo: se vende por debajo del costo; en ámbar: margen menor al 20 %. Stock = compras − ventas registradas."/>
        </VBox>
    </Tab>

    <Tab text="Categorías">
        <VBox spacing="14" styleClass="page">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label styleClass="muted" wrapText="true"
                       text="Agrupa tus productos y servicios para analizarlos por categoría."/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEliminarCategoriaFGEM" text="Eliminar" styleClass="button-secondary"
                        minWidth="-Infinity" onAction="#eliminarCategoriaFGEM">
                </Button>
                <Button fx:id="btnEditarCategoriaFGEM" text="Editar" styleClass="button-secondary"
                        minWidth="-Infinity" onAction="#editarCategoriaFGEM">
                </Button>
                <Button fx:id="btnNuevaCategoriaFGEM" text="Nueva categoría" styleClass="button-primary"
                        minWidth="-Infinity" onAction="#nuevaCategoriaFGEM">
                </Button>
            </HBox>
            <TableView fx:id="tablaCategoriasFGEM" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCatNombreFGEM" text="Nombre" prefWidth="220"/>
                    <TableColumn fx:id="colCatDescripcionFGEM" text="Descripción" prefWidth="420"/>
                    <TableColumn fx:id="colCatCantidadFGEM" text="Ítems" prefWidth="80" styleClass="col-numero"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </Tab>
</TabPane>
