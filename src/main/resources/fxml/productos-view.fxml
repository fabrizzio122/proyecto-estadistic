<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.businessanalyzer.controller.ProductosController"
         tabClosingPolicy="UNAVAILABLE">

    <!-- Pestaña 1: catálogo -->
    <Tab text="Productos y servicios">
        <VBox spacing="14" styleClass="page">
            <!-- Indicadores del catálogo -->
            <HBox fx:id="indicadores" spacing="16"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por código o nombre" prefWidth="210" minWidth="120"/>
                <ComboBox fx:id="cmbFiltroTipo" prefWidth="155" minWidth="155"/>
                <ComboBox fx:id="cmbFiltroCategoria" prefWidth="190" minWidth="190"/>
                <CheckBox fx:id="chkArchivados" text="Archivados" minWidth="-Infinity" onAction="#cargar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEditar" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                        onAction="#editar">
                    <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                </Button>
                <MenuButton fx:id="menuAcciones" text="Acciones" styleClass="button-secondary" minWidth="-Infinity">
                    <items>
                        <MenuItem fx:id="itemHistorial" text="Historial de precios" onAction="#verHistorial"/>
                        <MenuItem fx:id="itemEstado" text="Archivar" onAction="#cambiarEstado"/>
                    </items>
                </MenuButton>
                <Button fx:id="btnNuevo" text="Nuevo" styleClass="button-primary" minWidth="-Infinity"
                        onAction="#nuevo">
                    <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                </Button>
            </HBox>

            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="210"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="80"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
                    <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="60"/>
                    <TableColumn fx:id="colCosto" text="Costo" prefWidth="95" styleClass="col-numero"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="95" styleClass="col-numero"/>
                    <TableColumn fx:id="colMargen" text="Margen" prefWidth="95" styleClass="col-numero"/>
                    <TableColumn fx:id="colMargenPct" text="Margen %" prefWidth="85" styleClass="col-numero"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="lblNota" styleClass="hint" wrapText="true"
                   text="Precios sin impuestos. Margen % = (precio − costo) ÷ precio. En rojo: se vende por debajo del costo; en ámbar: margen menor al 20 %."/>
        </VBox>
    </Tab>

    <!-- Pestaña 2: categorías -->
    <Tab text="Categorías">
        <VBox spacing="14" styleClass="page">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label styleClass="muted" wrapText="true"
                       text="Agrupa tus productos y servicios para analizarlos por categoría."/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEliminarCategoria" text="Eliminar" styleClass="button-secondary"
                        minWidth="-Infinity" onAction="#eliminarCategoria">
                    <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
                </Button>
                <Button fx:id="btnEditarCategoria" text="Editar" styleClass="button-secondary"
                        minWidth="-Infinity" onAction="#editarCategoria">
                    <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                </Button>
                <Button fx:id="btnNuevaCategoria" text="Nueva categoría" styleClass="button-primary"
                        minWidth="-Infinity" onAction="#nuevaCategoria">
                    <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                </Button>
            </HBox>
            <TableView fx:id="tablaCategorias" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCatNombre" text="Nombre" prefWidth="220"/>
                    <TableColumn fx:id="colCatDescripcion" text="Descripción" prefWidth="420"/>
                    <TableColumn fx:id="colCatCantidad" text="Ítems" prefWidth="80" styleClass="col-numero"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </Tab>
</TabPane>
