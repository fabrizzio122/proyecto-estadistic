<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.ImportacionControllerFGEM"
      spacing="16" styleClass="page">

    <!-- Pasos -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" prefWidth="440" minWidth="380">
        <VBox spacing="14">
            <VBox styleClass="card" spacing="10">
                <Label text="1. Descarga la plantilla" styleClass="card-title"/>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Un libro de Excel con las hojas Productos, Ventas, Compras y Gastos, con instrucciones y listas desplegables. Llena solo las hojas que necesites; también puedes pegar tus propias columnas si tienen encabezados parecidos."/>
                <FlowPane hgap="8" vgap="8">
                    <Button text="Plantilla vacía…" styleClass="button-secondary" minWidth="-Infinity" onAction="#guardarPlantillaVaciaFGEM">
                        <graphic><FontIcon iconLiteral="fth-download"/></graphic>
                    </Button>
                    <Button text="Con ejemplo de bodega…" styleClass="button-secondary" minWidth="-Infinity" onAction="#guardarPlantillaEjemploFGEM">
                        <graphic><FontIcon iconLiteral="fth-shopping-bag"/></graphic>
                    </Button>
                </FlowPane>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="El ejemplo trae tres meses de una bodega (14 productos, ventas por boleta, reposición semanal y gastos del mes) para probar la importación."/>
            </VBox>

            <VBox styleClass="card" spacing="10">
                <Label text="2. Elige tu archivo" styleClass="card-title"/>
                <Label fx:id="lblEmpresaFGEM" styleClass="info-value" wrapText="true" minHeight="-Infinity"/>
                <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                    <Button fx:id="btnElegirFGEM" text="Elegir archivo de Excel…" styleClass="button-primary"
                            minWidth="-Infinity" onAction="#elegirArchivoFGEM">
                        <graphic><FontIcon iconLiteral="fth-file"/></graphic>
                    </Button>
                    <Button fx:id="btnRevisarFGEM" text="Revisar otra vez" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#revisarOtraVezFGEM">
                        <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                    </Button>
                    <ProgressIndicator fx:id="progresoFGEM" prefWidth="22" prefHeight="22" visible="false"/>
                </FlowPane>
                <Label fx:id="lblArchivoFGEM" styleClass="hint" wrapText="true" minHeight="-Infinity"/>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Primero se revisa todo el archivo sin guardar nada. Verás qué se va a importar y, si hay errores, la hoja y la fila exactas."/>
            </VBox>

            <VBox styleClass="card" spacing="10">
                <Label text="3. Importa" styleClass="card-title"/>
                <Button fx:id="btnImportarFGEM" text="Importar a la empresa activa" styleClass="button-primary"
                        minWidth="-Infinity" onAction="#importarFGEM">
                    <graphic><FontIcon iconLiteral="fth-upload"/></graphic>
                </Button>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Se habilita cuando la revisión no tiene errores. Antes de importar se guarda una copia de seguridad («Antes de importar») por si necesitas volver atrás desde Configuración."/>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Resultado -->
    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
        <Label text="Revisión del archivo" styleClass="card-title"/>
        <Label fx:id="lblEstadoFGEM" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"
               text="Elige un archivo para ver aquí lo que se va a importar."/>
        <FlowPane fx:id="panelConteosFGEM" hgap="10" vgap="10"/>
        <VBox fx:id="cajaAdvertenciasFGEM" spacing="6"/>
        <Label fx:id="lblTituloErroresFGEM" text="Filas por corregir" styleClass="form-label"/>
        <TableView fx:id="tablaErroresFGEM" VBox.vgrow="ALWAYS" styleClass="tabla-compacta">
            <columns>
                <TableColumn fx:id="colHojaFGEM" text="Hoja" prefWidth="100" minWidth="90"/>
                <TableColumn fx:id="colFilaFGEM" text="Fila" prefWidth="60" minWidth="55" styleClass="col-numero"/>
                <TableColumn fx:id="colProblemaFGEM" text="Problema" prefWidth="500"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
            </columnResizePolicy>
        </TableView>
    </VBox>
</HBox>
