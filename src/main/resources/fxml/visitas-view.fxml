<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.businessanalyzer.controller.VisitasController"
      spacing="14" styleClass="page">

    <!-- Indicadores principales -->
    <HBox fx:id="indicadores" spacing="16"/>

    <TabPane fx:id="pestanas" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE" styleClass="tabs-internas">

        <!-- 1. Visitas -->
        <Tab text="Visitas">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkAnuladas" text="Incluir anuladas" minWidth="-Infinity" onAction="#cargar"/>
                    <ProgressIndicator fx:id="progreso" prefWidth="22" prefHeight="22" visible="false"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnInforme" text="Informe técnico (PDF)" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#generarInforme">
                        <graphic><FontIcon iconLiteral="fth-file-text"/></graphic>
                    </Button>
                    <Button fx:id="btnFotos" text="Fotos" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#verFotos">
                        <graphic><FontIcon iconLiteral="fth-camera"/></graphic>
                    </Button>
                    <Button fx:id="btnEditar" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#editarVisita">
                        <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                    </Button>
                    <Button fx:id="btnAnular" text="Anular" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#anularVisita">
                        <graphic><FontIcon iconLiteral="fth-x-circle"/></graphic>
                    </Button>
                    <Button fx:id="btnNueva" text="Nueva visita" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#nuevaVisita">
                        <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                    </Button>
                </HBox>
                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tablaVisitas" HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="90"/>
                            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="150"/>
                            <TableColumn fx:id="colInspector" text="Inspector" prefWidth="140"/>
                            <TableColumn fx:id="colCumplimiento" text="Cumplimiento" prefWidth="100" styleClass="col-numero"/>
                            <TableColumn fx:id="colConclusion" text="Conclusión" prefWidth="160"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                        </columnResizePolicy>
                    </TableView>
                    <VBox styleClass="card" spacing="10" prefWidth="340" minWidth="300">
                        <Label fx:id="lblDetalleTitulo" text="Detalle de la visita" styleClass="card-title" wrapText="true"/>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll" VBox.vgrow="ALWAYS">
                            <VBox fx:id="detalle" spacing="8"/>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>

        <!-- 2. Compromisos -->
        <Tab text="Compromisos">
            <VBox spacing="10" styleClass="tab-contenido">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <CheckBox fx:id="chkSoloPendientes" text="Solo pendientes" minWidth="-Infinity" selected="true"
                              onAction="#filtrarCompromisos"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnPendiente" text="Volver a pendiente" styleClass="button-secondary"
                            minWidth="-Infinity" onAction="#marcarPendiente">
                        <graphic><FontIcon iconLiteral="fth-rotate-ccw"/></graphic>
                    </Button>
                    <Button fx:id="btnIncumplido" text="No cumplido" styleClass="button-secondary" minWidth="-Infinity"
                            onAction="#marcarIncumplido">
                        <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                    </Button>
                    <Button fx:id="btnCumplido" text="Cumplido" styleClass="button-primary" minWidth="-Infinity"
                            onAction="#marcarCumplido">
                        <graphic><FontIcon iconLiteral="fth-check"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tablaCompromisos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colComDescripcion" text="Compromiso" prefWidth="300"/>
                        <TableColumn fx:id="colComAcordado" text="Acordado" prefWidth="90"/>
                        <TableColumn fx:id="colComPlazo" text="Plazo" prefWidth="90"/>
                        <TableColumn fx:id="colComEstado" text="Estado" prefWidth="130"/>
                        <TableColumn fx:id="colComVerificacion" text="Verificación" prefWidth="220"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label styleClass="hint" wrapText="true" minHeight="-Infinity"
                       text="Los compromisos se acuerdan al registrar una visita. En la visita siguiente aparecen para verificarlos; también puedes marcarlos aquí."/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
