<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import com.businessanalyzer.config.VersionApp?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Primer arranque: creacion de la cuenta de administrador. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.businessanalyzer.controller.ConfiguracionInicialController"
           styleClass="login-bg">

    <VBox styleClass="login-card" spacing="14" maxWidth="460" maxHeight="-Infinity">
        <HBox styleClass="login-brand">
            <FontIcon iconLiteral="fth-bar-chart-2" styleClass="brand-icon"/>
            <VBox>
                <Label text="Business Analyzer" styleClass="brand-title"/>
                <Label styleClass="brand-subtitle">
                    <text><VersionApp fx:constant="SUBTITULO"/></text>
                </Label>
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label text="Bienvenido" styleClass="login-title"/>
            <Label styleClass="muted" wrapText="true"
                   text="Es la primera vez que se usa el sistema. Crea la cuenta de administrador, que podrá registrar al resto de usuarios."/>
        </VBox>

        <VBox spacing="6">
            <Label text="Usuario" styleClass="form-label"/>
            <TextField fx:id="txtUsuario" promptText="Ej.: admin"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Nombre completo" styleClass="form-label"/>
            <TextField fx:id="txtNombre" promptText="Nombre y apellidos"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Correo electrónico (opcional)" styleClass="form-label"/>
            <TextField fx:id="txtEmail" promptText="correo@empresa.com"/>
        </VBox>
        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Contraseña" styleClass="form-label"/>
                <PasswordField fx:id="txtPassword"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Confirmar contraseña" styleClass="form-label"/>
                <PasswordField fx:id="txtConfirmacion" onAction="#crear"/>
            </VBox>
        </HBox>
        <Label fx:id="lblPolitica" styleClass="hint" wrapText="true"/>

        <Label fx:id="lblError" styleClass="form-error" wrapText="true" maxWidth="1.7976931348623157E308"
               visible="false" managed="false"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="btnCrear" text="Crear administrador e ingresar" styleClass="button-primary, login-button"
                    defaultButton="true" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"
                    onAction="#crear"/>
            <ProgressIndicator fx:id="progreso" prefWidth="26" prefHeight="26" visible="false" managed="false"/>
        </HBox>
    </VBox>
</StackPane>
