<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.businessanalyzer.controller.ConfiguracionInicialControllerFGEM"
           styleClass="pantalla-acceso">

    <VBox spacing="12" maxWidth="440" maxHeight="-Infinity" styleClass="acceso-card">
        <VBox spacing="4">
            <Label text="Business Analyzer" styleClass="acceso-titulo"/>
            <Label styleClass="acceso-subtitulo" wrapText="true"
                   text="Configuración inicial: crea la cuenta del administrador."/>
        </VBox>

        <VBox spacing="6">
            <Label text="Usuario" styleClass="form-label"/>
            <TextField fx:id="txtUsuarioFGEM" styleClass="campo-acceso"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Nombre completo" styleClass="form-label"/>
            <TextField fx:id="txtNombreFGEM" styleClass="campo-acceso"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Correo electrónico (opcional)" styleClass="form-label"/>
            <TextField fx:id="txtEmailFGEM" styleClass="campo-acceso"/>
        </VBox>
        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Contraseña" styleClass="form-label"/>
                <PasswordField fx:id="txtPasswordFGEM" styleClass="campo-acceso"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Confirmar contraseña" styleClass="form-label"/>
                <PasswordField fx:id="txtConfirmacionFGEM" onAction="#crearFGEM" styleClass="campo-acceso"/>
            </VBox>
        </HBox>
        <Label fx:id="lblPoliticaFGEM" styleClass="hint" wrapText="true"/>

        <Label fx:id="lblErrorFGEM" styleClass="form-error" wrapText="true" maxWidth="1.7976931348623157E308"
               visible="false" managed="false"/>

        <StackPane>
            <Button fx:id="btnCrearFGEM" text="Crear administrador" styleClass="button-primary, acceso-boton"
                    defaultButton="true" maxWidth="1.7976931348623157E308" onAction="#crearFGEM"/>
            <ProgressIndicator fx:id="progresoFGEM" prefWidth="20" prefHeight="20" visible="false" managed="false"
                               StackPane.alignment="CENTER_RIGHT">
                <StackPane.margin><Insets right="12"/></StackPane.margin>
            </ProgressIndicator>
        </StackPane>
    </VBox>
</StackPane>
