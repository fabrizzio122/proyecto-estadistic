<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.businessanalyzer.controller.UsuariosController"
         tabClosingPolicy="UNAVAILABLE">

    <!-- Pestaña 1: cuentas de usuario -->
    <Tab text="Usuarios">
        <VBox spacing="14" styleClass="page">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por usuario, nombre, correo o rol"
                           prefWidth="320" minWidth="180"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEditar" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                        onAction="#editar">
                    <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
                </Button>
                <MenuButton fx:id="menuAcciones" text="Acciones" styleClass="button-secondary" minWidth="-Infinity">
                    <items>
                        <MenuItem fx:id="itemEstado" text="Desactivar" onAction="#cambiarEstado"/>
                        <MenuItem fx:id="itemRestablecer" text="Restablecer contraseña" onAction="#restablecerPassword"/>
                        <MenuItem fx:id="itemDesbloquear" text="Desbloquear cuenta" onAction="#desbloquear"/>
                    </items>
                </MenuButton>
                <Button text="Nuevo usuario" styleClass="button-primary" minWidth="-Infinity" onAction="#nuevo">
                    <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
                </Button>
            </HBox>

            <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="140"/>
                    <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="220"/>
                    <TableColumn fx:id="colEmail" text="Correo" prefWidth="200"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="120"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                    <TableColumn fx:id="colUltimoAcceso" text="Último acceso" prefWidth="140"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </Tab>

    <!-- Pestaña 2: matriz de roles y permisos -->
    <Tab text="Roles y permisos">
        <VBox spacing="14" styleClass="page">
            <VBox fx:id="listaRoles" spacing="6"/>
            <TableView fx:id="tablaPermisos" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </Tab>

    <!-- Pestaña 3: bitácora de seguridad -->
    <Tab text="Registro de accesos">
        <VBox spacing="14" styleClass="page">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblAccesos" styleClass="muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" styleClass="button-secondary" onAction="#cargarAccesos">
                    <graphic><FontIcon iconLiteral="fth-refresh-cw"/></graphic>
                </Button>
            </HBox>
            <TableView fx:id="tablaAccesos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colAccFecha" text="Fecha" prefWidth="140"/>
                    <TableColumn fx:id="colAccUsuario" text="Usuario" prefWidth="140"/>
                    <TableColumn fx:id="colAccEvento" text="Evento" prefWidth="300"/>
                    <TableColumn fx:id="colAccResponsable" text="Realizado por" prefWidth="140"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </Tab>
</TabPane>
