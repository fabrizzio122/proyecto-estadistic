<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.businessanalyzer.controller.UsuariosControllerFGEM"
         tabClosingPolicy="UNAVAILABLE">

    <Tab text="Usuarios">
        <VBox spacing="14" styleClass="page">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscarFGEM" promptText="Buscar por usuario, nombre, correo o rol"
                           prefWidth="320" minWidth="180"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEditarFGEM" text="Editar" styleClass="button-secondary" minWidth="-Infinity"
                        onAction="#editarFGEM">
                </Button>
                <MenuButton fx:id="menuAccionesFGEM" text="Acciones" styleClass="button-secondary" minWidth="-Infinity">
                    <items>
                        <MenuItem fx:id="itemEstadoFGEM" text="Desactivar" onAction="#cambiarEstadoFGEM"/>
                        <MenuItem fx:id="itemRestablecerFGEM" text="Restablecer contraseña" onAction="#restablecerPasswordFGEM"/>
                        <MenuItem fx:id="itemDesbloquearFGEM" text="Desbloquear cuenta" onAction="#desbloquearFGEM"/>
                    </items>
                </MenuButton>
                <Button text="Nuevo usuario" styleClass="button-primary" minWidth="-Infinity" onAction="#nuevoFGEM">
                </Button>
            </HBox>

            <TableView fx:id="tablaUsuariosFGEM" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colUsuarioFGEM" text="Usuario" prefWidth="140"/>
                    <TableColumn fx:id="colNombreFGEM" text="Nombre completo" prefWidth="220"/>
                    <TableColumn fx:id="colEmailFGEM" text="Correo" prefWidth="200"/>
                    <TableColumn fx:id="colRolFGEM" text="Rol" prefWidth="120"/>
                    <TableColumn fx:id="colEstadoFGEM" text="Estado" prefWidth="110"/>
                    <TableColumn fx:id="colUltimoAccesoFGEM" text="Último acceso" prefWidth="140"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </Tab>

    <Tab text="Roles y permisos">
        <VBox spacing="14" styleClass="page">
            <VBox fx:id="listaRolesFGEM" spacing="6"/>
            <TableView fx:id="tablaPermisosFGEM" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </Tab>

    <Tab text="Registro de accesos">
        <VBox spacing="14" styleClass="page">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="lblAccesosFGEM" styleClass="muted"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" styleClass="button-secondary" onAction="#cargarAccesosFGEM">
                </Button>
            </HBox>
            <TableView fx:id="tablaAccesosFGEM" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colAccFechaFGEM" text="Fecha" prefWidth="140"/>
                    <TableColumn fx:id="colAccUsuarioFGEM" text="Usuario" prefWidth="140"/>
                    <TableColumn fx:id="colAccEventoFGEM" text="Evento" prefWidth="300"/>
                    <TableColumn fx:id="colAccResponsableFGEM" text="Realizado por" prefWidth="140"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </Tab>
</TabPane>
