@startuml 06-secuencia-diagnostico
!include estilo.iuml
title Business Analyzer Desktop 1.2 — Diagnóstico empresarial
autonumber

actor Analista
participant ":DiagnosticoControllerFGEM" as CTRL
participant ":DiagnosticoServiceFGEM" as SRV
participant ":DatabaseFGEM" as DB
participant "ConsultaMensualFGEM" as CM
participant ":ConsultaPatrimonioFGEM" as CP
participant "MotorDiagnosticoFGEM" as MOTOR
participant "SimuladorFGEM" as SIM

Analista -> CTRL : abre «Diagnóstico empresarial»
CTRL -> SRV : diagnosticarFGEM()  [en segundo plano]
activate SRV
SRV -> SRV : requerirFGEM(ANALISIS_VER)\nempresaDeTrabajoFGEM()
SRV -> DB : enTransaccionFGEM(c -> …)
activate DB
SRV -> CM : porMesFGEM(c, …, 24 meses)
CM --> SRV : ventas, costos y gastos por mes
SRV -> CP : situacionFGEM(c, empresaId, hoy)
CP --> SRV : liquidez y endeudamiento
opt empresa agropecuaria
  SRV -> SRV : indicadores del hato y campañas\n(vs. mismo período del año anterior)
end
deactivate DB
SRV -> MOTOR : evaluarFGEM(DatosDiagnosticoFGEM)
activate MOTOR
loop por cada indicador (15 generales + 4 agro)
  MOTOR -> MOTOR : valor vs. umbrales del sector\n→ VERDE / AMARILLO / ROJO
end
MOTOR -> MOTOR : puntaje ponderado → NivelSaludFGEM\n(tope «En riesgo» si un indicador clave está en rojo)
MOTOR -> SIM : cambioPrecioParaMeta / cambioVolumenParaMeta
SIM --> MOTOR : cifras para las recomendaciones
MOTOR --> SRV : DiagnosticoFGEM (nivel, hallazgos, recomendaciones)
deactivate MOTOR
SRV --> CTRL : diagnóstico
deactivate SRV
CTRL -> Analista : semáforos, puntaje y\nrecomendaciones con cifras
@enduml
