@startuml 05-secuencia-registrar-venta
!include estilo.iuml
title Business Analyzer Desktop 1.2 — Registrar una venta
autonumber

actor Operador
participant ":OperacionesControllerFGEM" as CTRL
participant "TareasFGEM" as T
participant ":OperacionServiceFGEM" as SRV
participant ":SesionFGEM" as SES
participant ":EmpresaServiceFGEM" as EMP
participant "ValidadorOperacionFGEM" as VAL
participant ":DatabaseFGEM" as DB
participant ":ProductoRepositoryFGEM" as PR
participant "CalculadoraOperacionFGEM" as CALC
participant ":OperacionRepositoryFGEM" as OR
database "SQLite" as SQL

Operador -> CTRL : completa el formulario\ny pulsa «Registrar»
CTRL -> T : ejecutarFGEM(tarea)
activate T
T -> SRV : registrarFGEM(datos, permitirStockNegativo = false)
activate SRV
SRV -> SES : requerirFGEM(OPERACIONES_GESTIONAR)
SRV -> EMP : empresaDeTrabajoFGEM()
EMP --> SRV : empresa activa (acceso verificado)
SRV -> VAL : normalizarFGEM(datos, hoy)
VAL --> SRV : datos válidos
SRV -> DB : enTransaccionFGEM(c -> registrarEnFGEM(...))
activate DB
DB -> SQL : BEGIN
loop por cada línea
  SRV -> PR : buscarPorIdFGEM(c, productoId)
  PR -> SQL : SELECT … (stock calculado)
  PR --> SRV : producto
end
alt stock insuficiente
  SRV --> DB : StockInsuficienteExceptionFGEM
  DB -> SQL : ROLLBACK
  DB --> T : excepción
  T --> CTRL : alFallar(excepción)
  CTRL -> Operador : «¿Registrar de todos modos?»
  note right : si confirma, se repite con\npermitirStockNegativo = true
else stock suficiente
  SRV -> CALC : calcularFGEM(líneas, tasaImpuesto)
  CALC --> SRV : subtotal, IGV, total, costo
  SRV -> OR : siguienteNumeroFGEM(c, empresa, VENTA)
  SRV -> OR : insertarFGEM(c, operación)
  OR -> SQL : INSERT operacion
  loop por cada línea
    SRV -> OR : insertarLineaFGEM(c, …, costo congelado)
    OR -> SQL : INSERT operacion_linea
  end
  DB -> SQL : COMMIT
  DB --> SRV : operación registrada
  deactivate DB
  SRV --> T : operación
  deactivate SRV
  T --> CTRL : alTerminar(operación)
  deactivate T
  CTRL -> Operador : notificación «Venta V-000123 registrada»\ny refresca la tabla
end

note over SRV, OR
  Corregir = en la MISMA transacción se anula la original
  («Corregida: reemplazada por V-…») y se registra la nueva.
  Si algo falla, no se pierde ni se duplica nada.
end note
@enduml
