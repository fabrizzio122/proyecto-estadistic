@startuml 04-clases-analisis
!include estilo.iuml
title Business Analyzer Desktop 1.2 — Motor de análisis (paquete analytics)
hide empty members

package service {
  class AnalisisServiceFGEM
  class EstadisticaServiceFGEM
  class PrediccionServiceFGEM
  class SimulacionServiceFGEM
  class DiagnosticoServiceFGEM
  class ValoracionServiceFGEM
  class TesoreriaServiceFGEM
  class ConsultaMensualFGEM <<utilidad>> {
    {static} porMesFGEM(cFGEM, operacionesFGEM, movimientosFGEM, empresaIdFGEM, …) : List<MesFGEM>
  }
}

package analytics {
  class EstadoResultadosFGEM {
    ventasFGEM, costoVentasFGEM, utilidadBrutaFGEM
    gastosOperativosFGEM, utilidadNetaFGEM
  }
  class PuntoEquilibrioFGEM {
    ventasEquilibrioFGEM : BigDecimal
    margenSeguridadFGEM : BigDecimal
  }
  class PeriodoFGEM {
    desdeFGEM, hastaFGEM : LocalDate
    anteriorFGEM() : PeriodoFGEM
  }
  class RentabilidadProductoFGEM
}

package analytics.estadistica {
  class EstadisticaDescriptivaFGEM
  class TendenciaFGEM {
    pendienteFGEM, r2FGEM
    «SimpleRegression»
  }
  class AnalisisAbcFGEM
  class MatrizCorrelacionFGEM
  class EstacionalidadSemanalFGEM
}

package analytics.prediccion {
  interface MetodoPronosticoFGEM {
    nombreFGEM() : String
    pronosticarFGEM(historiaFGEM : double[], horizonteFGEM : int) : double[]
  }
  class TendenciaLinealFGEM
  class PromedioMovilFGEM
  class SuavizadoHoltFGEM
  class PronosticadorFGEM {
    {static} METODOS_FGEM : List<MetodoPronosticoFGEM>
    {static} pronosticarFGEM(serieFGEM, historiaFGEM, horizonteFGEM, noNegativoFGEM) : PronosticoFGEM
    «valida rolling-origin, menor MAE»
  }
}

package analytics.simulacion {
  class BaseSimulacionFGEM
  class SupuestosFGEM
  class SimuladorFGEM {
    {static} simularFGEM(baseFGEM, supuestosFGEM) : ResultadoEscenarioFGEM
    {static} sensibilidadFGEM(baseFGEM, supuestosFGEM) : ±10 %
    {static} cambioPrecioParaMetaFGEM(baseFGEM, supuestosFGEM, metaFGEM)
  }
}

package analytics.diagnostico {
  class MotorDiagnosticoFGEM {
    {static} evaluarFGEM(DatosDiagnosticoFGEM) : DiagnosticoFGEM
  }
  class DatosDiagnosticoFGEM
  class DiagnosticoFGEM {
    nivelFGEM : NivelSaludFGEM
    puntajeFGEM : int
  }
  class HallazgoFGEM {
    tipoFGEM : TipoIndicadorFGEM
    semaforoFGEM : SemaforoFGEM
    lecturaFGEM : String
    recomendacionFGEM : String
  }
  enum SemaforoFGEM {
    VERDE
    AMARILLO
    ROJO
  }
}

package analytics.valoracion {
  class ValoracionNegocioFGEM {
    {static} calcularFGEM(supuestosFGEM, patrimonialFGEM, utilidadAnualFGEM, …)
  }
}

package analytics.tesoreria {
  class FlujoDineroFGEM <<record>> {
    fechaFGEM, cuentaIdFGEM, montoFGEM, rubroFGEM
  }
  class SaldoCuentaFGEM {
    {static} deFGEM(cuentasFGEM, flujosFGEM, corteFGEM)
  }
  class FlujoEfectivoFGEM {
    saldoInicialFGEM, porRubroFGEM, saldoFinalFGEM
    netoFGEM(ActividadFGEM) : BigDecimal
  }
  class ProyeccionCajaFGEM {
    {static} calcularFGEM(hoyFGEM, saldoFGEM, historiaFGEM, deudasFGEM)
    primerNegativoFGEM : YearMonth
  }
}

MetodoPronosticoFGEM <|.. TendenciaLinealFGEM
MetodoPronosticoFGEM <|.. PromedioMovilFGEM
MetodoPronosticoFGEM <|.. SuavizadoHoltFGEM
PronosticadorFGEM o--> "3" MetodoPronosticoFGEM

SimuladorFGEM ..> BaseSimulacionFGEM
SimuladorFGEM ..> SupuestosFGEM
MotorDiagnosticoFGEM ..> DatosDiagnosticoFGEM
MotorDiagnosticoFGEM ..> SimuladorFGEM : cifras de las\nrecomendaciones
MotorDiagnosticoFGEM --> DiagnosticoFGEM
DiagnosticoFGEM "1" *-- "15..19" HallazgoFGEM
SaldoCuentaFGEM ..> FlujoDineroFGEM
FlujoEfectivoFGEM ..> FlujoDineroFGEM
ProyeccionCajaFGEM ..> PronosticadorFGEM : flujo de operación
MotorDiagnosticoFGEM ..> ProyeccionCajaFGEM : caja proyectada
TesoreriaServiceFGEM ..> FlujoEfectivoFGEM
TesoreriaServiceFGEM ..> ProyeccionCajaFGEM
HallazgoFGEM --> SemaforoFGEM
PuntoEquilibrioFGEM ..> EstadoResultadosFGEM

AnalisisServiceFGEM ..> EstadoResultadosFGEM
AnalisisServiceFGEM ..> PuntoEquilibrioFGEM
AnalisisServiceFGEM ..> RentabilidadProductoFGEM
EstadisticaServiceFGEM ..> EstadisticaDescriptivaFGEM
EstadisticaServiceFGEM ..> TendenciaFGEM
EstadisticaServiceFGEM ..> AnalisisAbcFGEM
PrediccionServiceFGEM ..> PronosticadorFGEM
SimulacionServiceFGEM ..> SimuladorFGEM
DiagnosticoServiceFGEM ..> MotorDiagnosticoFGEM
DiagnosticoServiceFGEM ..> ConsultaMensualFGEM
EstadisticaServiceFGEM ..> ConsultaMensualFGEM
PrediccionServiceFGEM ..> ConsultaMensualFGEM
ValoracionServiceFGEM ..> ValoracionNegocioFGEM
ValoracionServiceFGEM ..> TendenciaFGEM : crecimiento\nsugerido

note bottom of PronosticadorFGEM
  Patrón Estrategia: los tres métodos se
  prueban con los últimos meses reales y
  se queda el de menor error (MAE).
  Intervalo: ±1,96 · RMSE · √h
end note
@enduml
