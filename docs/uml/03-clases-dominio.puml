@startuml 03-clases-dominio
!include estilo.iuml
title Business Analyzer Desktop 1.2 — Modelo de dominio (paquete model)
hide empty methods

package "Seguridad" {
  class UsuarioFGEM <<record>> {
    nombreUsuarioFGEM : String
    nombreCompletoFGEM : String
    activoFGEM : boolean
    intentosFallidosFGEM : int
    bloqueadoHastaFGEM : LocalDateTime
    --
    tieneFGEM(PermisoFGEM) : boolean
    bloqueadoEnFGEM(LocalDateTime) : boolean
  }
  class RolFGEM <<record>> {
    codigoFGEM : String
    nombreFGEM : String
    permisosFGEM : Set<PermisoFGEM>
  }
  enum PermisoFGEM {
    DASHBOARD_VER
    OPERACIONES_GESTIONAR
    ANALISIS_VER
    AGRO_GESTIONAR
    VISITAS_REGISTRAR
    … (16 en total)
  }
}

package "Empresa y catálogo" {
  class EmpresaFGEM <<record>> {
    razonSocialFGEM : String
    identificacionFiscalFGEM : String
    sectorFGEM : SectorFGEM
    tamanoFGEM : TamanoEmpresaFGEM
    monedaFGEM : MonedaFGEM
    mesInicioEjercicioFGEM : int
  }
  enum SectorFGEM {
    COMERCIO
    RESTAURANTE
    SERVICIOS
    AGROPECUARIO
    …
  }
  class CategoriaFGEM <<record>>
  class ProductoFGEM <<record>> {
    tipoFGEM : TipoItemFGEM
    codigoFGEM : String
    costoUnitarioFGEM : BigDecimal
    precioVentaFGEM : BigDecimal
    stockFGEM : BigDecimal  «calculado»
  }
}

package "Operaciones y finanzas" {
  class OperacionFGEM <<record>> {
    tipoFGEM : TipoOperacionFGEM  «VENTA / COMPRA»
    numeroFGEM : String
    fechaFGEM : LocalDate
    subtotalFGEM, impuestoFGEM, totalFGEM : BigDecimal
    costoTotalFGEM : BigDecimal
    estadoFGEM : EstadoOperacionFGEM
    condicionFGEM : CondicionPagoFGEM  «CONTADO / CREDITO»
    vencimientoFGEM : LocalDate
    --
    margenBrutoFGEM() : BigDecimal
    pendienteFGEM() : BigDecimal
    anuladaFGEM() : boolean
  }
  class LineaOperacionFGEM <<record>> {
    cantidadFGEM : BigDecimal
    precioUnitarioFGEM : BigDecimal
    costoUnitarioFGEM : BigDecimal  «congelado»
  }
  class MovimientoFinancieroFGEM <<record>> {
    tipoFGEM : TipoMovimientoFGEM  «INGRESO / GASTO»
    categoriaFGEM : CategoriaFinancieraFGEM
    comportamientoFGEM : ComportamientoFGEM  «FIJO / VARIABLE»
    montoFGEM : BigDecimal
  }
  class ActivoFGEM <<record>> {
    categoriaFGEM : CategoriaActivoFGEM
    valorFGEM : BigDecimal
    vidaUtilAniosFGEM : Integer
  }
  class DeudaFGEM <<record>> {
    acreedorFGEM : String
    montoFGEM : BigDecimal
    tasaAnualFGEM : BigDecimal
  }
  class PagoDeudaFGEM <<record>> {
    montoFGEM : BigDecimal  «capital»
    interesFGEM : BigDecimal
  }
  class EscenarioFGEM <<record>>
  class InformeGeneradoFGEM <<record>>
}

package "Tesorería" {
  class CuentaDineroFGEM <<record>> {
    nombreFGEM : String
    tipoFGEM : TipoCuentaFGEM  «CAJA / BANCO / BILLETERA»
    saldoInicialFGEM : BigDecimal
    activaFGEM : boolean
  }
  class PagoOperacionFGEM <<record>> {
    fechaFGEM : LocalDate
    montoFGEM : BigDecimal
  }
  class MovimientoTesoreriaFGEM <<record>> {
    tipoFGEM : TipoMovimientoTesoreriaFGEM
    «TRANSFERENCIA / APORTE / RETIRO»
    montoFGEM : BigDecimal
  }
}

package "Agropecuario" {
  class MovimientoGanadoFGEM <<record>> {
    tipoFGEM : TipoMovimientoGanadoFGEM
    categoriaFGEM : CategoriaGanadoFGEM
    cantidadFGEM : int
  }
  class ProduccionGanaderaFGEM <<record>> {
    especieFGEM : EspecieFGEM
    productoFGEM : ProductoGanaderoFGEM
    cantidadFGEM : BigDecimal
  }
  class ParcelaFGEM <<record>> {
    areaFGEM : BigDecimal  «ha»
    tenenciaFGEM : TenenciaFGEM
    riegoFGEM : boolean
  }
  class CampaniaFGEM <<record>> {
    cultivoFGEM : CultivoFGEM
    fechaSiembraFGEM : LocalDate
    estadoFGEM : EstadoCampaniaFGEM
  }
  class CostoCampaniaFGEM <<record>>
  class CosechaFGEM <<record>> {
    cantidadFGEM : BigDecimal  «kg»
    destinoFGEM : DestinoCosechaFGEM
  }
  class VisitaFGEM <<record>> {
    tipoFGEM : TipoVisitaFGEM
    inspectorFGEM : String
    conclusionFGEM : ConclusionVisitaFGEM
  }
  class CompromisoFGEM <<record>> {
    estadoFGEM : EstadoCompromisoFGEM
  }
  class FotoVisitaFGEM <<record>>
}

UsuarioFGEM "*" --> "1" RolFGEM
RolFGEM "*" --> "*" PermisoFGEM
UsuarioFGEM "*" -- "*" EmpresaFGEM : acceso >
EmpresaFGEM --> SectorFGEM

EmpresaFGEM "1" *-- "*" CategoriaFGEM
EmpresaFGEM "1" *-- "*" ProductoFGEM
CategoriaFGEM "0..1" <-- "*" ProductoFGEM
EmpresaFGEM "1" *-- "*" OperacionFGEM
OperacionFGEM "1" *-- "1..*" LineaOperacionFGEM
LineaOperacionFGEM "*" --> "1" ProductoFGEM
EmpresaFGEM "1" *-- "*" MovimientoFinancieroFGEM
EmpresaFGEM "1" *-- "*" ActivoFGEM
EmpresaFGEM "1" *-- "*" DeudaFGEM
DeudaFGEM "1" *-- "*" PagoDeudaFGEM
PagoDeudaFGEM "0..1" --> "0..1" MovimientoFinancieroFGEM : intereses >

EmpresaFGEM "1" *-- "1..*" CuentaDineroFGEM
OperacionFGEM "1" *-- "*" PagoOperacionFGEM : cobros / pagos >
PagoOperacionFGEM "*" --> "1" CuentaDineroFGEM
OperacionFGEM "*" --> "0..1" CuentaDineroFGEM : al contado >
MovimientoFinancieroFGEM "*" --> "0..1" CuentaDineroFGEM
ActivoFGEM "*" --> "0..1" CuentaDineroFGEM : pagado desde >
DeudaFGEM "*" --> "0..1" CuentaDineroFGEM : ingresó a >
PagoDeudaFGEM "*" --> "0..1" CuentaDineroFGEM
MovimientoTesoreriaFGEM "*" --> "0..2" CuentaDineroFGEM : origen / destino >
EmpresaFGEM "1" *-- "*" MovimientoTesoreriaFGEM
EmpresaFGEM "1" *-- "*" EscenarioFGEM
EmpresaFGEM "1" *-- "*" InformeGeneradoFGEM

EmpresaFGEM "1" *-- "*" MovimientoGanadoFGEM
EmpresaFGEM "1" *-- "*" ProduccionGanaderaFGEM
EmpresaFGEM "1" *-- "*" ParcelaFGEM
ParcelaFGEM "1" *-- "*" CampaniaFGEM
CampaniaFGEM "1" *-- "*" CostoCampaniaFGEM
CampaniaFGEM "1" *-- "*" CosechaFGEM
EmpresaFGEM "1" *-- "*" VisitaFGEM
VisitaFGEM "1" *-- "*" CompromisoFGEM
VisitaFGEM "1" *-- "*" FotoVisitaFGEM

note "Los módulos agropecuarios solo se\nmuestran si sector = AGROPECUARIO." as N1
N1 .. SectorFGEM
@enduml
