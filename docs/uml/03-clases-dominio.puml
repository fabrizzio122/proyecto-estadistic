@startuml 03-clases-dominio
!include estilo.iuml
title Business Analyzer Desktop 1.2 — Modelo de dominio (paquete model)
hide empty methods

package "Seguridad" {
  class Usuario <<record>> {
    nombreUsuario : String
    nombreCompleto : String
    activo : boolean
    intentosFallidos : int
    bloqueadoHasta : LocalDateTime
    --
    tiene(Permiso) : boolean
    bloqueadoEn(LocalDateTime) : boolean
  }
  class Rol <<record>> {
    codigo : String
    nombre : String
    permisos : Set<Permiso>
  }
  enum Permiso {
    DASHBOARD_VER
    OPERACIONES_GESTIONAR
    ANALISIS_VER
    AGRO_GESTIONAR
    VISITAS_REGISTRAR
    … (16 en total)
  }
}

package "Empresa y catálogo" {
  class Empresa <<record>> {
    razonSocial : String
    identificacionFiscal : String
    sector : Sector
    tamano : TamanoEmpresa
    moneda : Moneda
    mesInicioEjercicio : int
  }
  enum Sector {
    COMERCIO
    RESTAURANTE
    SERVICIOS
    AGROPECUARIO
    …
  }
  class Categoria <<record>>
  class Producto <<record>> {
    tipo : TipoItem
    codigo : String
    costoUnitario : BigDecimal
    precioVenta : BigDecimal
    stock : BigDecimal  «calculado»
  }
}

package "Operaciones y finanzas" {
  class Operacion <<record>> {
    tipo : TipoOperacion  «VENTA / COMPRA»
    numero : String
    fecha : LocalDate
    subtotal, impuesto, total : BigDecimal
    costoTotal : BigDecimal
    estado : EstadoOperacion
    condicion : CondicionPago  «CONTADO / CREDITO»
    vencimiento : LocalDate
    --
    margenBruto() : BigDecimal
    pendiente() : BigDecimal
    anulada() : boolean
  }
  class LineaOperacion <<record>> {
    cantidad : BigDecimal
    precioUnitario : BigDecimal
    costoUnitario : BigDecimal  «congelado»
  }
  class MovimientoFinanciero <<record>> {
    tipo : TipoMovimiento  «INGRESO / GASTO»
    categoria : CategoriaFinanciera
    comportamiento : Comportamiento  «FIJO / VARIABLE»
    monto : BigDecimal
  }
  class Activo <<record>> {
    categoria : CategoriaActivo
    valor : BigDecimal
    vidaUtilAnios : Integer
  }
  class Deuda <<record>> {
    acreedor : String
    monto : BigDecimal
    tasaAnual : BigDecimal
  }
  class PagoDeuda <<record>> {
    monto : BigDecimal  «capital»
    interes : BigDecimal
  }
  class Escenario <<record>>
  class InformeGenerado <<record>>
}

package "Tesorería" {
  class CuentaDinero <<record>> {
    nombre : String
    tipo : TipoCuenta  «CAJA / BANCO / BILLETERA»
    saldoInicial : BigDecimal
    activa : boolean
  }
  class PagoOperacion <<record>> {
    fecha : LocalDate
    monto : BigDecimal
  }
  class MovimientoTesoreria <<record>> {
    tipo : TipoMovimientoTesoreria
    «TRANSFERENCIA / APORTE / RETIRO»
    monto : BigDecimal
  }
}

package "Agropecuario" {
  class MovimientoGanado <<record>> {
    tipo : TipoMovimientoGanado
    categoria : CategoriaGanado
    cantidad : int
  }
  class ProduccionGanadera <<record>> {
    especie : Especie
    producto : ProductoGanadero
    cantidad : BigDecimal
  }
  class Parcela <<record>> {
    area : BigDecimal  «ha»
    tenencia : Tenencia
    riego : boolean
  }
  class Campania <<record>> {
    cultivo : Cultivo
    fechaSiembra : LocalDate
    estado : EstadoCampania
  }
  class CostoCampania <<record>>
  class Cosecha <<record>> {
    cantidad : BigDecimal  «kg»
    destino : DestinoCosecha
  }
  class Visita <<record>> {
    tipo : TipoVisita
    inspector : String
    conclusion : ConclusionVisita
  }
  class Compromiso <<record>> {
    estado : EstadoCompromiso
  }
  class FotoVisita <<record>>
}

Usuario "*" --> "1" Rol
Rol "*" --> "*" Permiso
Usuario "*" -- "*" Empresa : acceso >
Empresa --> Sector

Empresa "1" *-- "*" Categoria
Empresa "1" *-- "*" Producto
Categoria "0..1" <-- "*" Producto
Empresa "1" *-- "*" Operacion
Operacion "1" *-- "1..*" LineaOperacion
LineaOperacion "*" --> "1" Producto
Empresa "1" *-- "*" MovimientoFinanciero
Empresa "1" *-- "*" Activo
Empresa "1" *-- "*" Deuda
Deuda "1" *-- "*" PagoDeuda
PagoDeuda "0..1" --> "0..1" MovimientoFinanciero : intereses >

Empresa "1" *-- "1..*" CuentaDinero
Operacion "1" *-- "*" PagoOperacion : cobros / pagos >
PagoOperacion "*" --> "1" CuentaDinero
Operacion "*" --> "0..1" CuentaDinero : al contado >
MovimientoFinanciero "*" --> "0..1" CuentaDinero
Activo "*" --> "0..1" CuentaDinero : pagado desde >
Deuda "*" --> "0..1" CuentaDinero : ingresó a >
PagoDeuda "*" --> "0..1" CuentaDinero
MovimientoTesoreria "*" --> "0..2" CuentaDinero : origen / destino >
Empresa "1" *-- "*" MovimientoTesoreria
Empresa "1" *-- "*" Escenario
Empresa "1" *-- "*" InformeGenerado

Empresa "1" *-- "*" MovimientoGanado
Empresa "1" *-- "*" ProduccionGanadera
Empresa "1" *-- "*" Parcela
Parcela "1" *-- "*" Campania
Campania "1" *-- "*" CostoCampania
Campania "1" *-- "*" Cosecha
Empresa "1" *-- "*" Visita
Visita "1" *-- "*" Compromiso
Visita "1" *-- "*" FotoVisita

note "Los módulos agropecuarios solo se\nmuestran si sector = AGROPECUARIO." as N1
N1 .. Sector
@enduml
