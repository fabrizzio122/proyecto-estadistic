@startuml 07-estados-campania
!include estilo.iuml
title Business Analyzer Desktop 1.2 — Estados de una campaña agrícola

[*] --> EN_CURSO : registrarCampaniaFGEM()\n[parcela activa]

state "En curso" as EN_CURSO
EN_CURSO : costos y cosechas se registran,\ncorrigen o anulan
EN_CURSO : su costo acumulado cuenta como\nactivo «cultivos» en el balance

state "Cosechada" as COSECHADA
COSECHADA : rendimiento y margen definitivos
COSECHADA : el costo no vendido pasa al\nestado de resultados

state "Perdida" as PERDIDA
PERDIDA : causa obligatoria\n(helada, granizo, sequía…)

state "Anulada" as ANULADA
ANULADA : no cuenta en resultados\nni en el balance

EN_CURSO --> COSECHADA : cerrarCampaniaFGEM(COSECHADA)\n[al menos una cosecha]
EN_CURSO --> PERDIDA : cerrarCampaniaFGEM(PERDIDA, causa)
COSECHADA --> EN_CURSO : reabrirCampaniaFGEM()
PERDIDA --> EN_CURSO : reabrirCampaniaFGEM()
EN_CURSO --> ANULADA : anularCampaniaFGEM(motivo)
COSECHADA --> ANULADA : anularCampaniaFGEM(motivo)
PERDIDA --> ANULADA : anularCampaniaFGEM(motivo)
ANULADA --> [*]
@enduml
